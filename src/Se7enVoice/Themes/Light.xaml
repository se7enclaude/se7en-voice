<!-- Palette claire (par défaut) du design « Centrale Audio » : verre liquide sur un fond sable chaud. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fond : sable chaud + taches de lumière floues (ardoise, violet, menthe, rose) -->
    <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#F1ECE6" Offset="0" />
        <GradientStop Color="#E4DBD3" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Leak1Brush" Center="0.88,0.08" GradientOrigin="0.88,0.08" RadiusX="0.55" RadiusY="0.5">
        <GradientStop Color="#8C6E7C98" Offset="0" /><GradientStop Color="#006E7C98" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Leak2Brush" Center="0.8,0.82" GradientOrigin="0.8,0.82" RadiusX="0.38" RadiusY="0.34">
        <GradientStop Color="#529678FF" Offset="0" /><GradientStop Color="#009678FF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Leak3Brush" Center="0.12,0.88" GradientOrigin="0.12,0.88" RadiusX="0.34" RadiusY="0.3">
        <GradientStop Color="#424FCDB8" Offset="0" /><GradientStop Color="#004FCDB8" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Leak4Brush" Center="0.6,0.95" GradientOrigin="0.6,0.95" RadiusX="0.3" RadiusY="0.28">
        <GradientStop Color="#59F7B8D2" Offset="0" /><GradientStop Color="#00F7B8D2" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141416" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E141416" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B141416" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnSolidBrush" Color="#141416" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7A64F0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#6450DC" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#247A64F0" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#4FCDB8" />
    <SolidColorBrush x:Key="Accent2TextBrush" Color="#2FB09C" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#294FCDB8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#1F8A3E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2934C759" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#D2302A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#24FF453A" />

    <SolidColorBrush x:Key="GlassFillBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="GlassFillStrongBrush" Color="#85FFFFFF" />
    <SolidColorBrush x:Key="GlassTileBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeInnerBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#F0FFFFFF" />
    <SolidColorBrush x:Key="MenuBrush" Color="#F2FBF9F7" />
    <SolidColorBrush x:Key="TooltipBrush" Color="#DB141416" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WellBrush" Color="#12141416" />
    <SolidColorBrush x:Key="WellStrongBrush" Color="#1F141416" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14141416" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#4D28201C" />
    <SolidColorBrush x:Key="MeterOffBrush" Color="#1A141416" />

    <!-- Carte mise en avant (une par vue) -->
    <LinearGradientBrush x:Key="IridescentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8C9A8" Offset="0" />
        <GradientStop Color="#F7B8D2" Offset="0.28" />
        <GradientStop Color="#C9B8F5" Offset="0.58" />
        <GradientStop Color="#9EE4F2" Offset="1" />
    </LinearGradientBrush>

    <!-- Ombres : reflet blanc en haut + longue ombre chaude -->
    <DropShadowEffect x:Key="PanelShadow" Color="#30201A" BlurRadius="60" ShadowDepth="26" Direction="270" Opacity="0.22" />
    <DropShadowEffect x:Key="TileShadow" Color="#30201A" BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.18" />
    <DropShadowEffect x:Key="PillShadow" Color="#30201A" BlurRadius="20" ShadowDepth="8" Direction="270" Opacity="0.26" />
    <DropShadowEffect x:Key="AccentGlow" Color="#7A64F0" BlurRadius="24" ShadowDepth="10" Direction="270" Opacity="0.5" />
    <DropShadowEffect x:Key="MintGlow" Color="#2FB09C" BlurRadius="24" ShadowDepth="10" Direction="270" Opacity="0.45" />
    <DropShadowEffect x:Key="DangerGlow" Color="#FF453A" BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.45" />
    <DropShadowEffect x:Key="IridGlow" Color="#966EDC" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.4" />
    <DropShadowEffect x:Key="PopShadow" Color="#1E1410" BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.3" />
</ResourceDictionary>
