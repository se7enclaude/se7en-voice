<!--
  Slipstream Design System, adapté à WPF.
  Fond froid (night / violet), interaction chaude (volt, blaze, surge, boost, neon, hazard),
  biais de vitesse (-12°), ombres dures sans flou, coins quasi droits.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Se7enVoice.Controls">

    <!-- ===== Couleurs ===== -->
    <Color x:Key="Night950">#07061A</Color>
    <Color x:Key="Night900">#0D0B2E</Color>
    <Color x:Key="Night800">#16134A</Color>
    <Color x:Key="Night700">#221D66</Color>
    <Color x:Key="Night600">#2F2884</Color>
    <Color x:Key="Violet500">#4A3FB0</Color>
    <Color x:Key="Violet400">#6B5FD0</Color>
    <Color x:Key="Violet300">#8F85E3</Color>
    <Color x:Key="Violet200">#B8B0F2</Color>
    <Color x:Key="Violet100">#DCD8FB</Color>
    <Color x:Key="Paper">#F6F4FF</Color>
    <Color x:Key="Volt500">#FFCB2E</Color>
    <Color x:Key="Volt300">#FFE27A</Color>
    <Color x:Key="Blaze500">#FF7A1A</Color>
    <Color x:Key="Surge500">#2FD6EE</Color>
    <Color x:Key="Boost500">#19D9A3</Color>
    <Color x:Key="Neon500">#FF3FA4</Color>
    <Color x:Key="Hazard500">#FF3344</Color>

    <SolidColorBrush x:Key="Night950Brush" Color="{StaticResource Night950}" />
    <SolidColorBrush x:Key="Night900Brush" Color="{StaticResource Night900}" />
    <SolidColorBrush x:Key="Night800Brush" Color="{StaticResource Night800}" />
    <SolidColorBrush x:Key="Night700Brush" Color="{StaticResource Night700}" />
    <SolidColorBrush x:Key="Night600Brush" Color="{StaticResource Night600}" />
    <SolidColorBrush x:Key="Violet500Brush" Color="{StaticResource Violet500}" />
    <SolidColorBrush x:Key="Violet400Brush" Color="{StaticResource Violet400}" />
    <SolidColorBrush x:Key="Violet300Brush" Color="{StaticResource Violet300}" />
    <SolidColorBrush x:Key="Violet200Brush" Color="{StaticResource Violet200}" />
    <SolidColorBrush x:Key="Violet100Brush" Color="{StaticResource Violet100}" />
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}" />
    <SolidColorBrush x:Key="VoltBrush" Color="{StaticResource Volt500}" />
    <SolidColorBrush x:Key="Volt300Brush" Color="{StaticResource Volt300}" />
    <SolidColorBrush x:Key="BlazeBrush" Color="{StaticResource Blaze500}" />
    <SolidColorBrush x:Key="SurgeBrush" Color="{StaticResource Surge500}" />
    <SolidColorBrush x:Key="BoostBrush" Color="{StaticResource Boost500}" />
    <SolidColorBrush x:Key="NeonBrush" Color="{StaticResource Neon500}" />
    <SolidColorBrush x:Key="HazardBrush" Color="{StaticResource Hazard500}" />

    <SolidColorBrush x:Key="PanelBrush" Color="#6B8F85E3" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#8C6B5FD0" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#59DCD8FB" />
    <SolidColorBrush x:Key="SlotBrush" Color="#5B52B0" />
    <SolidColorBrush x:Key="SlotInnerBrush" Color="#4C43A0" />
    <SolidColorBrush x:Key="InsetBrush" Color="#2407061A" />
    <SolidColorBrush x:Key="InsetHoverBrush" Color="#5207061A" />

    <!-- ===== Polices ===== -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Saira Condensed ExtraBold</FontFamily>
    <FontFamily x:Key="FontDisplayBlack">pack://application:,,,/Assets/Fonts/#Saira Condensed Black</FontFamily>
    <FontFamily x:Key="FontUi">pack://application:,,,/Assets/Fonts/#Josefin SS 600</FontFamily>
    <FontFamily x:Key="FontUiBold">pack://application:,,,/Assets/Fonts/#Josefin SS 700</FontFamily>
    <FontFamily x:Key="FontUiRegular">pack://application:,,,/Assets/Fonts/#Josefin SS 400</FontFamily>
    <FontFamily x:Key="FontComic">pack://application:,,,/Assets/Fonts/#Bangers</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SkewTransform x:Key="Slant" AngleX="-12" />
    <SkewTransform x:Key="SlantSoft" AngleX="-8" />

    <!-- ===== Textes ===== -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform" Value="{StaticResource SlantSoft}" />
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUiBold}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="0,4,0,0" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUiRegular}" />
        <Setter Property="Foreground" Value="{StaticResource Violet100Brush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUiBold}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="0,3,0,0" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="Foreground" Value="{StaticResource Violet200Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0,2,0,0" />
    </Style>
    <Style x:Key="NumText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource VoltBrush}" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Panel « verre » avec barre d'en-tête ===== -->
    <Style x:Key="FrostPanel" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Night950}" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.45" />
                        </Border.Effect>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" MinHeight="52"
                                    CornerRadius="3,3,0,0" Padding="22,6,8,6">
                                <DockPanel>
                                    <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Header}" FontFamily="{StaticResource FontUiBold}" FontSize="22"
                                               Foreground="{StaticResource PaperBrush}" VerticalAlignment="Center" Padding="0,5,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="{StaticResource Night950}" BlurRadius="0" ShadowDepth="2" Direction="270" Opacity="0.25" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Boutons en parallélogramme avec ombre dure ===== -->
    <Style x:Key="SlantButton" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource VoltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Night900Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Margin="6,0,10,0">
                        <Border x:Name="shadow" Background="{StaticResource Night950Brush}" Margin="4,4,-4,-4"
                                RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}" />
                        <Grid x:Name="face" RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}">
                            <Border Background="{TemplateBinding Background}" />
                            <Border x:Name="sheen" Background="White" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="sheen" Property="Opacity" Value="0.22" />
                            <Setter TargetName="face" Property="Margin" Value="0,-2,0,2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="Margin" Value="2,2,-2,-2" />
                            <Setter TargetName="sheen" Property="Opacity" Value="0.1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SlantButton}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SlantButton}">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SlantButton}">
        <Setter Property="Background" Value="{StaticResource Night700Brush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SlantButton}">
        <Setter Property="Background" Value="{StaticResource HazardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
    </Style>
    <Style x:Key="SmallGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Gros bouton bascule (MUET, ME RÉÉCOUTER) : ghost au repos, couleur d'accent quand actif -->
    <Style x:Key="BigToggle" TargetType="ToggleButton" BasedOn="{StaticResource SlantButton}">
        <Setter Property="Background" Value="{StaticResource Night700Brush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Height" Value="54" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="8,0" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{StaticResource Night900Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Onglets en haut -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Violet200Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="4,0">
                        <Border x:Name="shadow" Background="{StaticResource Night950Brush}" Margin="4,4,-4,-4" Opacity="0"
                                RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}" />
                        <Border x:Name="face" Background="Transparent" Padding="20,0"
                                RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource Night600Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource VoltBrush}" />
                            <Setter TargetName="shadow" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Night900Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interrupteur ON/OFF incliné -->
    <Style x:Key="SlantSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="74" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}">
                        <Border x:Name="track" Background="{StaticResource Night800Brush}" BorderBrush="{StaticResource Night600Brush}" BorderThickness="2" />
                        <Border x:Name="knob" Width="32" Margin="3" HorizontalAlignment="Left" Background="{StaticResource Violet300Brush}">
                            <TextBlock x:Name="lbl" Text="OFF" FontFamily="{StaticResource FontDisplay}" FontSize="13"
                                       Foreground="{StaticResource Night900Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Background" Value="{StaticResource BoostBrush}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource BoostBrush}" />
                            <Setter TargetName="lbl" Property="Text" Value="ON" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Night700Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider = jauge Slipstream + curseur volt ===== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="34">
                        <Border Background="{StaticResource Night950Brush}" Margin="3,3,-3,-3" RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}" />
                        <Border x:Name="k" Background="{StaticResource VoltBrush}" RenderTransformOrigin="0.5,0.5" RenderTransform="{StaticResource Slant}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="k" Property="Background" Value="{StaticResource Volt300Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="k" Property="Background" Value="{StaticResource PaperBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="38" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="{StaticResource VoltBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <c:SlantMeter Height="16" Margin="8,0" VerticalAlignment="Center"
                                      Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                      Value="{TemplateBinding Value}" Origin="{Binding (c:SlantMeter.SliderOrigin), RelativeSource={RelativeSource TemplatedParent}}"
                                      Tone="{TemplateBinding Tag}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox sombre ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{StaticResource Night800Brush}" BorderBrush="{StaticResource SlotInnerBrush}" BorderThickness="3" CornerRadius="2">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource Violet200Brush}"
                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Violet400Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource VoltBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="14,10,14,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Night600Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource VoltBrush}" />
                            <Setter TargetName="b" Property="BorderThickness" Value="4,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                          Margin="16,4,40,0" VerticalAlignment="Center" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               PopupAnimation="Slide" Focusable="False">
                            <Border Background="{StaticResource Night800Brush}" BorderBrush="{StaticResource Violet400Brush}" BorderThickness="2"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,4,6,6">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource Night950}" BlurRadius="0" ShadowDepth="5" Direction="315" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Background" Value="{StaticResource Night800Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SlotInnerBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CaretBrush" Value="{StaticResource VoltBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="12,10,12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource VoltBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barres de défilement fines ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource Violet400Brush}" CornerRadius="2" Margin="1,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glyphe de touche (prompt manette/clavier) -->
    <Style x:Key="KeyChip" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,3,7,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Badge incliné -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Padding" Value="12,4,12,2" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform" Value="{StaticResource Slant}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Night900Brush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Night700Brush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Violet400Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="Padding" Value="10,7,10,4" />
    </Style>
</ResourceDictionary>
