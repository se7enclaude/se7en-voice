<!--
  Design system « Centrale Audio », adapté à WPF : verre liquide.
  Feuilles translucides qui flottent sur un fond doux, boutons « gel » violet / menthe, une seule carte irisée
  par vue. Typo Geist (titres 600, texte 400/500) et Geist Mono pour toutes les valeurs (dB, Hz, raccourcis).
  Les couleurs viennent de Dark.xaml (palette sombre, la seule de l'appli).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Se7enVoice.Controls">

    <!-- ===== Constantes (identiques dans les deux thèmes) ===== -->
    <Color x:Key="Violet500">#7A64F0</Color>
    <SolidColorBrush x:Key="InkBrush" Color="#141416" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VioletBrush" Color="#7A64F0" />
    <SolidColorBrush x:Key="MintBrush" Color="#4FCDB8" />
    <SolidColorBrush x:Key="GreenBrush" Color="#34C759" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="RedBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="StoneBrush" Color="#9A938D" />

    <!-- Gels (boutons) -->
    <LinearGradientBrush x:Key="GelVioletBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9683FA" Offset="0" /><GradientStop Color="#7A64F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelVioletHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A291FB" Offset="0" /><GradientStop Color="#8672F2" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelMintBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#79E0CF" Offset="0" /><GradientStop Color="#4FCDB8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelMintHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#88E6D7" Offset="0" /><GradientStop Color="#5ED4C0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GelRedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6B62" Offset="0" /><GradientStop Color="#FF453A" Offset="1" />
    </LinearGradientBrush>
    <!-- Reflet « gel » : bande claire en haut des boutons -->
    <LinearGradientBrush x:Key="GelSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="0.5" />
    </LinearGradientBrush>

    <!-- Puits d'icône (carrés arrondis en dégradé, icône blanche) -->
    <LinearGradientBrush x:Key="ToneViolet" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="#B7A9FF" Offset="0" /><GradientStop Color="#7A64F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToneMint" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="#A6EDE1" Offset="0" /><GradientStop Color="#4FCDB8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToneRose" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="#FBD3E3" Offset="0" /><GradientStop Color="#EE8FB7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TonePeach" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="#FBDCC6" Offset="0" /><GradientStop Color="#F0A57A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToneSky" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="#C8F0F8" Offset="0" /><GradientStop Color="#5CC9E3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToneNeutral" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="#9A938D" Offset="0" /><GradientStop Color="#56514D" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Polices ===== -->
    <FontFamily x:Key="FontSans">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="FontMedium">pack://application:,,,/Assets/Fonts/#Geist Medium</FontFamily>
    <FontFamily x:Key="FontSemi">pack://application:,,,/Assets/Fonts/#Geist SemiBold</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Assets/Fonts/#Geist Mono Medium</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Textes ===== -->
    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="H2Text" TargetType="TextBlock" BasedOn="{StaticResource H1Text}">
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style x:Key="H3Text" TargetType="TextBlock" BasedOn="{StaticResource H1Text}">
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource H3Text}" />
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="TertiaryText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <!-- Petits libellés en capitales espacées (ENTRÉES, SORTIE, PITCH) -->
    <Style x:Key="MicroText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="ReadoutText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <!-- Grand panneau de verre (rayon 32) -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Effect" Value="{DynamicResource PanelShadow}" />
    </Style>
    <!-- Pilule flottante (barre du haut, rail, barre du bas) -->
    <Style x:Key="GlassPill" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" />
    </Style>
    <!-- Tuile (rayon 22) -->
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeInnerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{DynamicResource TileShadow}" />
    </Style>
    <!-- Creux (fond légèrement teinté, sans ombre) -->
    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WellBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- Carte = tuile avec titre : Header, Ui.Icon (icône du titre), Ui.Subtitle, Tag (à droite) -->
    <Style x:Key="Card" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GlassTileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeInnerBrush}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="c:Ui.Icon" Value="" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border x:Name="box" CornerRadius="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}" Effect="{DynamicResource TileShadow}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <DockPanel>
                            <DockPanel x:Name="head" DockPanel.Dock="Top" Margin="0,0,0,14">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ic" DockPanel.Dock="Left" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="17"
                                           Opacity="0.62" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <ContentPresenter ContentSource="Header" TextElement.FontFamily="{StaticResource FontSemi}" TextElement.FontSize="17" />
                                    <TextBlock x:Name="sub" Text="{Binding (c:Ui.Subtitle), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontFamily="{StaticResource FontMedium}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="c:Ui.Subtitle" Value="">
                            <Setter TargetName="sub" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Tag" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="head" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Carte irisée : la chose mise en avant (une seule par vue) -->
    <Style x:Key="IridCard" TargetType="HeaderedContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource IridescentBrush}" />
        <Setter Property="BorderBrush" Value="#B3FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Puits d'icône : carré arrondi en dégradé, glyphe blanc -->
    <Style x:Key="IconWell" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{StaticResource ToneViolet}" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#59FFFFFF" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- ===== Boutons pilule (gel) ===== -->
    <Style x:Key="PillButtonBase" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource GelVioletBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Tag" Value="{StaticResource GelVioletHoverBrush}" />
        <Setter Property="c:Ui.Glow" Value="{DynamicResource AccentGlow}" />
        <Setter Property="c:Ui.Sheen" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}"
                                Effect="{TemplateBinding c:Ui.Glow}" />
                        <Border x:Name="sheen" Background="{StaticResource GelSheenBrush}" Margin="1" IsHitTestVisible="False"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,1" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="c:Ui.Sheen" Value="False">
                            <Setter TargetName="sheen" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource GelMintBrush}" />
        <Setter Property="Tag" Value="{StaticResource GelMintHoverBrush}" />
        <Setter Property="c:Ui.Glow" Value="{DynamicResource MintGlow}" />
    </Style>
    <Style x:Key="SolidButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
        <Setter Property="Tag" Value="White" />
        <Setter Property="c:Ui.Glow" Value="{DynamicResource PillShadow}" />
        <Setter Property="c:Ui.Sheen" Value="False" />
    </Style>
    <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Tag" Value="{DynamicResource SurfaceSolidBrush}" />
        <Setter Property="c:Ui.Glow" Value="{DynamicResource TileShadow}" />
        <Setter Property="c:Ui.Sheen" Value="False" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Tag" Value="{DynamicResource WellBrush}" />
        <Setter Property="c:Ui.Glow" Value="{x:Null}" />
        <Setter Property="c:Ui.Sheen" Value="False" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource GelRedBrush}" />
        <Setter Property="Tag" Value="{StaticResource GelRedBrush}" />
        <Setter Property="c:Ui.Glow" Value="{DynamicResource DangerGlow}" />
    </Style>
    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallSolidButton" TargetType="Button" BasedOn="{StaticResource SolidButton}">
        <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallGlassButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Bascule pilule : verre au repos, blanc plein quand active (ou couleur via Tag) -->
    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Tag" Value="{DynamicResource SurfaceSolidBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{DynamicResource GlassFillStrongBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,1" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource PillShadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallPillToggle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
        <Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- Mini-bouton de tranche (M, → MIC) : creux au repos, couleur pleine quand actif -->
    <Style x:Key="MiniPill" TargetType="ToggleButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource RedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{DynamicResource WellBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource WellStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton rond (icône) : verre, blanc plein au survol ; actif = blanc plein, ou couleur (Tag) -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Tag" Value="{DynamicResource SurfaceSolidBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource FontIcons}" FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource PillShadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Variante qui devient rouge/blanc quand active (muet, REC) -->
    <Style x:Key="DangerIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Setter Property="Tag" Value="{StaticResource RedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SmallIconButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="GhostIconButton" TargetType="ButtonBase" BasedOn="{StaticResource SmallIconButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ===== Navigation ===== -->
    <!-- Rail vertical d'icônes -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="22">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource FontIcons}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource WellBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource PillShadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Onglets en pilule (barre du bas) : actif = blanc plein -->
    <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,1" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource PillShadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Onglets soulignés (catégories) : actif = texte plein + trait violet -->
    <Style x:Key="UnderlineTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        <Border x:Name="bar" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="12,0" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Contrôle segmenté (Clair / Sombre, réglages en crans) -->
    <Style x:Key="SegItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="15" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,1" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource PillShadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnSolidBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WellBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- ===== Interrupteur (style iOS) : vert, ou violet via Tag ===== -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="51" />
        <Setter Property="Height" Value="31" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Tag" Value="{StaticResource GreenBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Background="{DynamicResource WellStrongBrush}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <Ellipse x:Name="knob" Margin="2" HorizontalAlignment="Left" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.22" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style x:Key="AccentSwitch" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
        <Setter Property="Tag" Value="{StaticResource VioletBrush}" />
    </Style>

    <!-- ===== Slider : rail 6 px + pastille blanche ===== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="22" Height="22">
                        <Ellipse x:Name="k" Fill="White" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.22" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="k" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <c:PillTrack Margin="11,0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                                     Origin="{Binding (c:PillTrack.SliderOrigin), RelativeSource={RelativeSource TemplatedParent}}" Tone="{TemplateBinding Tag}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource SliderThumb}" /></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Réglage : libellé + valeur (mono) + slider -->
    <Style TargetType="c:ParamSlider">
        <Setter Property="Tone" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ParamSlider">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding ValueText}" Style="{StaticResource ReadoutText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Slider x:Name="s" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Tag="{TemplateBinding Tone}" c:PillTrack.SliderOrigin="{TemplateBinding Origin}"
                                TickFrequency="{TemplateBinding Tick}" IsSnapToTickEnabled="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tick" Value="0">
                            <Setter TargetName="s" Property="IsSnapToTickEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Liste déroulante : pilule blanche, menu en verre ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{DynamicResource SurfaceSolidBrush}" Effect="{DynamicResource PillShadow}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="11" Foreground="#73141416" HorizontalAlignment="Right" Margin="0,0,16,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="10,8" CornerRadius="10" Margin="6,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource WellBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#141416" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="18,0,36,1" VerticalAlignment="Center" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1" CornerRadius="14"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,8,12,14" Padding="0,6"
                                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Champ texte (pilule de verre) ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barres de défilement fines ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource WellStrongBrush}" CornerRadius="3" /></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource WellStrongBrush}" CornerRadius="3" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Badges, touches ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontSemi}" />
        <Setter Property="TextElement.FontSize" Value="12" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style x:Key="SuccessBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>
    <Style x:Key="DangerBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style x:Key="MintBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource Accent2SoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent2TextBrush}" />
    </Style>
    <!-- Badge « EN DIRECT » / « REC » : rouge plein -->
    <Style x:Key="LiveBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource RedBrush}" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="Effect" Value="{DynamicResource DangerGlow}" />
    </Style>
    <Style x:Key="Tag" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style x:Key="KeyChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WellBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Étoile « favori » -->
    <Style x:Key="StarToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="ToolTip" Value="Favori (CTRL+ALT+F1…F9)" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="14">
                        <TextBlock x:Name="g" Text="&#xE734;" FontFamily="{StaticResource FontIcons}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource WellBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="g" Property="Text" Value="&#xE735;" />
                            <Setter TargetName="g" Property="Foreground" Value="{StaticResource AmberBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Infobulle, menu contextuel ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TooltipTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource TooltipBrush}" CornerRadius="10" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="6">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="10,8">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource WellBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
