<!--
  Design system « Centrale », adapté à WPF.
  Studio de nuit : fond encre presque noir, panneaux en verre, un seul accent électrique (Volt),
  couleurs secondaires réservées aux données (une couleur fixe par source audio), contrôles en pilule.
  Typo : Urbanist (titres, gros chiffres), Manrope (interface), JetBrains Mono (dB, Hz, ms, raccourcis).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Se7enVoice.Controls">

    <!-- ===== Couleurs ===== -->
    <Color x:Key="Ink1000">#050608</Color>
    <Color x:Key="Ink950">#08090C</Color>
    <Color x:Key="Ink900">#0C0E13</Color>
    <Color x:Key="Ink850">#111319</Color>
    <Color x:Key="Ink800">#161920</Color>
    <Color x:Key="Ink700">#1E222B</Color>
    <Color x:Key="Ink600">#282D38</Color>
    <Color x:Key="Ink500">#3A404D</Color>
    <Color x:Key="Ink300">#8A90A0</Color>
    <Color x:Key="Ink200">#B8BCC8</Color>
    <Color x:Key="Ink100">#E2E4EA</Color>
    <Color x:Key="Ink50">#F5F6F8</Color>
    <Color x:Key="Volt400">#E7F77A</Color>
    <Color x:Key="Volt500">#DDF247</Color>
    <Color x:Key="Volt600">#C3D92E</Color>
    <Color x:Key="Iris400">#C4B3FF</Color>
    <Color x:Key="Iris500">#A98BFA</Color>
    <Color x:Key="Mint500">#4FD1B0</Color>
    <Color x:Key="Sky500">#5EB8F2</Color>
    <Color x:Key="Amber500">#EDB842</Color>
    <Color x:Key="Coral400">#FF8A80</Color>
    <Color x:Key="Coral500">#F2605A</Color>
    <Color x:Key="Rose500">#E86FAE</Color>
    <Color x:Key="Green500">#9BDB5F</Color>

    <SolidColorBrush x:Key="Ink950Brush" Color="{StaticResource Ink950}" />
    <SolidColorBrush x:Key="Ink900Brush" Color="{StaticResource Ink900}" />
    <SolidColorBrush x:Key="Ink850Brush" Color="{StaticResource Ink850}" />
    <SolidColorBrush x:Key="Ink800Brush" Color="{StaticResource Ink800}" />
    <SolidColorBrush x:Key="Ink700Brush" Color="{StaticResource Ink700}" />
    <SolidColorBrush x:Key="Ink500Brush" Color="{StaticResource Ink500}" />
    <SolidColorBrush x:Key="Ink300Brush" Color="{StaticResource Ink300}" />
    <SolidColorBrush x:Key="Ink200Brush" Color="{StaticResource Ink200}" />
    <SolidColorBrush x:Key="Ink100Brush" Color="{StaticResource Ink100}" />
    <SolidColorBrush x:Key="Ink50Brush" Color="{StaticResource Ink50}" />
    <SolidColorBrush x:Key="VoltBrush" Color="{StaticResource Volt500}" />
    <SolidColorBrush x:Key="Volt400Brush" Color="{StaticResource Volt400}" />
    <SolidColorBrush x:Key="Volt600Brush" Color="{StaticResource Volt600}" />
    <SolidColorBrush x:Key="IrisBrush" Color="{StaticResource Iris500}" />
    <SolidColorBrush x:Key="Iris400Brush" Color="{StaticResource Iris400}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource Mint500}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource Sky500}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber500}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource Coral500}" />
    <SolidColorBrush x:Key="Coral400Brush" Color="{StaticResource Coral400}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource Rose500}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green500}" />

    <!-- Surfaces en verre (alpha blanc sur l'encre) -->
    <SolidColorBrush x:Key="Surface1Brush" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Surface4Brush" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="GlassBrush" Color="#F2161920" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A8050608" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="#8CDDF247" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A4A9B6" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E7482" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0C0E13" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24DDF247" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#29F2605A" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4DF2605A" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#29EDB842" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#295EB8F2" />

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6FE3C9" Offset="0" />
        <GradientStop Color="#B9EC72" Offset="0.52" />
        <GradientStop Color="#E6F45E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IrisGradBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D3C4FF" Offset="0" />
        <GradientStop Color="#A98BFA" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Polices ===== -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Urbanist SemiBold</FontFamily>
    <FontFamily x:Key="FontDisplayMedium">pack://application:,,,/Assets/Fonts/#Urbanist Medium</FontFamily>
    <FontFamily x:Key="FontDisplayBold">pack://application:,,,/Assets/Fonts/#Urbanist</FontFamily>
    <FontFamily x:Key="FontSans">pack://application:,,,/Assets/Fonts/#Manrope Medium</FontFamily>
    <FontFamily x:Key="FontSansSemi">pack://application:,,,/Assets/Fonts/#Manrope SemiBold</FontFamily>
    <FontFamily x:Key="FontSansBold">pack://application:,,,/Assets/Fonts/#Manrope</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono Medium</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Ombres et halos ===== -->
    <DropShadowEffect x:Key="PanelShadow" Color="Black" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5" />
    <DropShadowEffect x:Key="PopShadow" Color="Black" BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.7" />
    <DropShadowEffect x:Key="VoltGlow" Color="{StaticResource Volt500}" BlurRadius="24" ShadowDepth="0" Opacity="0.38" />
    <DropShadowEffect x:Key="LiveGlow" Color="{StaticResource Coral500}" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />

    <!-- ===== Textes ===== -->
    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplayMedium}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="H3Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="TertiaryText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="MicroText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansBold}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="ReadoutText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="NumberText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Carte (panneau en verre) : Header = titre, Tag = actions, Ui.Subtitle = sous-titre ===== -->
    <Style x:Key="Card" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Border x:Name="shadow" CornerRadius="20" Background="{StaticResource Ink950Brush}" Effect="{StaticResource PanelShadow}" Opacity="0.6" />
                        <Border x:Name="box" CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="20" Background="{StaticResource SheenBrush}" IsHitTestVisible="False" />
                                <DockPanel Margin="{TemplateBinding Padding}">
                                    <DockPanel x:Name="head" DockPanel.Dock="Top" Margin="0,0,0,14" MinHeight="32">
                                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ContentPresenter ContentSource="Header" TextElement.FontFamily="{StaticResource FontDisplay}" TextElement.FontSize="18" />
                                            <TextBlock x:Name="sub" Text="{Binding (c:Ui.Subtitle), RelativeSource={RelativeSource TemplatedParent}}"
                                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ContentPresenter />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Subtitle" Value="">
                            <Setter TargetName="sub" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Tag" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="head" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Carte mise en avant (voix active…) : halo Volt -->
    <Style x:Key="GlowCard" TargetType="HeaderedContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
        <Setter Property="Effect" Value="{StaticResource VoltGlow}" />
    </Style>
    <!-- Une seule par écran : dégradé menthe → lime, texte sombre -->
    <Style x:Key="HeroCard" TargetType="HeaderedContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource HeroBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
    </Style>

    <!-- Carte intérieure -->
    <Style x:Key="InnerCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Pastille ronde colorée avec glyphe sombre (sources, voix, sons) -->
    <Style x:Key="IconDot" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Ink900Brush}" />
    </Style>

    <!-- ===== Boutons pilule ===== -->
    <Style x:Key="PillButtonBase" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource VoltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource FontSansSemi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Tag" Value="{StaticResource Volt400Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource Surface3Brush}" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource Surface2Brush}" />
    </Style>
    <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource Ink50Brush}" />
        <Setter Property="Tag" Value="White" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Coral400Brush}" />
        <Setter Property="Tag" Value="#42F2605A" />
    </Style>
    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SmallGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Bascule pilule : secondaire au repos, couleur (Tag) quand active -->
    <Style x:Key="PillToggle" TargetType="ToggleButton" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource Ink50Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallPillToggle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- Mini-pilule M / → MIC des tranches (police mono) -->
    <Style x:Key="MiniPill" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource CoralBrush}" />
    </Style>

    <!-- Bouton rond (icône) -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="Tag" Value="{StaticResource VoltBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource FontIcons}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallIconButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style x:Key="GhostIconButton" TargetType="ButtonBase" BasedOn="{StaticResource SmallIconButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- ===== Onglets pilule ===== -->
    <Style x:Key="TabBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSansSemi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="{StaticResource Ink50Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="{TemplateBinding c:Ui.Icon}" FontFamily="{StaticResource FontIcons}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink900Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Onglets « verre » plus petits (filtres) : actif = surface claire, texte blanc -->
    <Style x:Key="GlassTab" TargetType="RadioButton" BasedOn="{StaticResource Tab}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,4,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" Margin="0,1,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface4Brush}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Interrupteur ===== -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Background="{StaticResource Surface4Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <Ellipse x:Name="knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left" Fill="{StaticResource Ink100Brush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource VoltBrush}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource Ink900Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider : rail pilule + pastille blanche ===== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18">
                        <Ellipse x:Name="halo" Fill="{StaticResource AccentSoftBrush}" Margin="-5" Opacity="0" />
                        <Ellipse Fill="{StaticResource Ink50Brush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.45" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="halo" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="halo" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="{StaticResource VoltBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <c:PillTrack Margin="9,0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                                     Origin="{Binding (c:PillTrack.SliderOrigin), RelativeSource={RelativeSource TemplatedParent}}" Tone="{TemplateBinding Tag}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeat}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Réglage : libellé + valeur (mono) + slider -->
    <Style TargetType="c:ParamSlider">
        <Setter Property="Tone" Value="{StaticResource VoltBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ParamSlider">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding ValueText}" Style="{StaticResource ReadoutText}" />
                            <TextBlock Text="{TemplateBinding Label}" FontFamily="{StaticResource FontSansSemi}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Slider x:Name="s" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Tag="{TemplateBinding Tone}" c:PillTrack.SliderOrigin="{TemplateBinding Origin}"
                                TickFrequency="{TemplateBinding Tick}" IsSnapToTickEnabled="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tick" Value="0">
                            <Setter TargetName="s" Property="IsSnapToTickEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Liste déroulante ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="12,8" CornerRadius="10" Margin="4,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource VoltBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                          Margin="16,1,34,0" VerticalAlignment="Center" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="14"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,6,10,12" Padding="0,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Champ texte ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource VoltBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource VoltBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barres de défilement fines ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource Surface4Brush}" CornerRadius="3" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource Surface4Brush}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Badges, tags, touches ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" />
        <Setter Property="Padding" Value="9,3,9,3" />
        <Setter Property="Background" Value="{StaticResource VoltBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Ink900Brush}" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansBold}" />
        <Setter Property="FontSize" Value="10.5" />
    </Style>
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontSansSemi}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="KeyChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Étoile « favori » -->
    <Style x:Key="StarToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="ToolTip" Value="Favori (CTRL+ALT+F1…F9)" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static c:PillRadius.Instance}}">
                        <TextBlock x:Name="g" Text="&#xE734;" FontFamily="{StaticResource FontIcons}" FontSize="14"
                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                            <Setter TargetName="g" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="g" Property="Text" Value="&#xE735;" />
                            <Setter TargetName="g" Property="Foreground" Value="{StaticResource VoltBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Infobulle, menu contextuel ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource GlassBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,8">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
