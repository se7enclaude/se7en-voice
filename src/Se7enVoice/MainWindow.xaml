<Window x:Class="Se7enVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Se7enVoice.Controls"
        xmlns:vm="clr-namespace:Se7enVoice.ViewModels"
        Title="se7en Voice" Width="1440" Height="900" MinWidth="1240" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        FontFamily="{StaticResource FontSans}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" AllowDrop="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- En-tête d'écran : titre Michroma + lecture mono, actions à droite -->
        <Style x:Key="ScreenHead" TargetType="DockPanel">
            <Setter Property="Margin" Value="2,4,0,16" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <!-- Libellé posé sur un plateau gris (texte noir) -->
        <Style x:Key="TrayLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Foreground" Value="{DynamicResource TextOnTrayBrush}" />
            <Setter Property="Margin" Value="6,2,0,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="c:ValueBar">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Ligne de réglage : texte à gauche, interrupteur à droite -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Tuile de voix : icône, nom, accroche ; voix active = inversée (fond bone, texte noir, halo) -->
        <DataTemplate x:Key="VoiceTile" DataType="{x:Type vm:PresetItem}">
            <Grid Height="92" Margin="0,0,8,8">
                <Button Cursor="Hand" Focusable="False" Click="PresetTile_Click" Tag="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="root">
                                <Border x:Name="b" Style="{StaticResource Raised}" Padding="10" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top">
                                            <c:Led DockPanel.Dock="Right" Tone="{Binding ToneBrush}" Width="7" Height="7" Margin="0,0,26,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="20" HorizontalAlignment="Left" />
                                        </DockPanel>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontSemi}" FontSize="15.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="tag" Text="{Binding Tagline}" FontSize="12.5" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="root" Property="RenderTransform">
                                        <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource InverseBrush}" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BoneBrush}" />
                                    <Setter TargetName="b" Property="Effect" Value="{DynamicResource SelectedGlow}" />
                                    <Setter TargetName="b" Property="TextElement.Foreground" Value="{DynamicResource TextInverseBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                            <MenuItem Header="Exporter (partager avec un ami)…" Click="ExportPreset_Click" Tag="{Binding}" />
                            <MenuItem Header="Supprimer" Click="DeletePreset_Click" Tag="{Binding}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ToggleButton Style="{StaticResource StarToggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                              IsChecked="{Binding IsFavorite, Mode=OneWay}" Click="Favorite_Click" Tag="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- Tranche de console : module noir de 104 px dans un plateau -->
        <Style x:Key="Strip" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Width" Value="116" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="StripDevice" TargetType="TextBlock" BasedOn="{StaticResource MetaText}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,3,0,12" />
        </Style>
        <Style x:Key="StripMeter" TargetType="c:LevelMeter">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="240" />
            <Setter Property="Vertical" Value="True" />
            <Setter Property="Segments" Value="40" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,0,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Barre du haut : marque, recherche, lectures mono, état ===== -->
            <DockPanel Grid.ColumnSpan="3" LastChildFill="True" Margin="6,0,0,0">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock c:Ui.Caps="se7en voice" FontFamily="{StaticResource FontDisplay}" FontSize="19" Foreground="{DynamicResource TextStrongBrush}" />
                    <TextBlock Text="centrale audio pour créateurs" Style="{StaticResource CaptionText}" Margin="1,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource MetaText}" Margin="0,0,16,0">
                            <Run Text="LAT" /> <Run Text="{Binding LatencyText, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding RateText}" Style="{StaticResource MetaText}" />
                    </StackPanel>
                    <Border Style="{StaticResource LiveBadge}" Margin="0,0,10,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource BadgeDot}" />
                            <TextBlock Style="{StaticResource BadgeText}"><Run Text="EN DIRECT · " /><Run Text="{Binding RecordingTime, Mode=OneWay}" FontFamily="{StaticResource FontMono}" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DangerBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Live}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <c:Led Round="True" Width="6" Height="6" Margin="0,0,6,0" Tone="{DynamicResource GreenBrush}" Visibility="{Binding Live, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource BadgeText}">
                                <TextBlock.Text>
                                    <Binding Path="Live" Converter="{x:Static vm:Converters.LiveText}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ToggleButton Margin="0,0,6,0" IsChecked="{Binding Muted}" ToolTip="Couper le micro (Ctrl + Alt + M)">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource DangerIconToggle}">
                                <Setter Property="Content" Value="&#xE720;" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="&#xF781;" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Click="Record_Click" MinWidth="140" Margin="0" ToolTip="Enregistre ce qu'entendent vos amis (Ctrl + Alt + R)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Enregistrer" />
                                <Setter Property="c:Ui.Icon" Value="&#xE7C8;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Content" Value="Arrêter" />
                                        <Setter Property="c:Ui.Icon" Value="&#xE71A;" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                        <Setter Property="Tag" Value="#1AFF3D33" />
                                        <Setter Property="Effect" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="12,0,6,0" />
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE921;" FontSize="11" Click="Minimize_Click" ToolTip="Réduire" />
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE922;" FontSize="11" Click="Maximize_Click" ToolTip="Agrandir" />
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE8BB;" FontSize="11" Click="Close_Click" ToolTip="Fermer" />
                </StackPanel>

                <!-- Recherche de voix -->
                <Grid Width="340" HorizontalAlignment="Left" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Text="{Binding PresetSearch, UpdateSourceTrigger=PropertyChanged}" Padding="36,0,10,0" GotKeyboardFocus="SearchBox_GotFocus" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock Text="Rechercher une voix…" Style="{StaticResource StrongText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="37,0,0,1"
                               IsHitTestVisible="False" Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>

            <!-- ===== Rail de navigation (72 px) ===== -->
            <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource Panel}" Padding="0,12">
                <DockPanel>
                    <RadioButton x:Name="TabSettings" DockPanel.Dock="Bottom" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE713;" Content="Réglages" ToolTip="Micro virtuel, périphériques, raccourcis"
                                 GroupName="Nav" Checked="Tab_Checked" Margin="0" HorizontalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Ink500Brush}" Margin="0,0,0,5" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Ink500Brush}" Margin="0,0,0,5" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Ink500Brush}" Margin="0,0,0,5" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Ink500Brush}" Margin="0,0,0,5" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource Ink500Brush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <RadioButton x:Name="TabVoice" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE720;" Content="Voix" ToolTip="Choisir une voix" GroupName="Nav" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabEffects" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE945;" Content="Effets" ToolTip="Régler chaque effet" GroupName="Nav" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabMixer" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE9E9;" Content="Mixage" ToolTip="Volume du micro et des applis" GroupName="Nav" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabSounds" Style="{StaticResource RailItem}" c:Ui.Icon="&#xF0E2;" Content="Sons" ToolTip="Soundboard" GroupName="Nav" Checked="Tab_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Écrans ===== -->
            <Grid Grid.Row="1" Grid.Column="2">

                <!-- ========== STUDIO VOCAL ========== -->
                <DockPanel x:Name="PageVoice">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE8B5;" Content="Importer" Click="ImportPreset_Click" ToolTip="Ajoute une voix envoyée par un ami (.json)" />
                            <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE710;" Content="Créer une voix" Click="SavePreset_Click" Margin="0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VOIX" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <TextBlock Style="{StaticResource MetaText}"><Run Text="Voix active ·" /> <Run Text="{Binding CurrentPresetName, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" /></TextBlock>
                            </StackPanel>
                            <TextBlock Text="Cliquez sur une voix : elle s'applique tout de suite à votre micro. Ajustez-la avec les barres à droite." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <!-- Bibliothèque de voix -->
                        <Border Style="{StaticResource Panel}" Padding="12,12,4,4">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,8,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LibraryTitle}" Style="{StaticResource MetaText}" FontSize="11.5" />
                                    <TextBlock c:Ui.Caps="Voix" Style="{StaticResource LabelText}" />
                                </DockPanel>

                                <!-- Prêt pour Discord : ce qui manque, avec le bouton pour le régler -->
                                <Border DockPanel.Dock="Top" Style="{StaticResource Well}" Padding="16,10,16,6" Margin="0,0,8,14"
                                        Visibility="{Binding ReadyForDiscord, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock c:Ui.Caps="Prêt pour Discord ? Encore une étape" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextStrongBrush}" Margin="0,4,0,4" />
                                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                
                                                <c:Led DockPanel.Dock="Left" Round="True" Width="10" Height="10" Margin="2,0,14,0">
                                                    <c:Led.Style>
                                                        <Style TargetType="c:Led">
                                                            <Setter Property="Tone" Value="{DynamicResource GreenBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MicFound}" Value="False"><Setter Property="Tone" Value="{DynamicResource RedBrush}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </c:Led.Style>
                                                </c:Led>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StrongText}">
                                                                <Setter Property="Text" Value="Micro branché" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MicFound}" Value="False"><Setter Property="Text" Value="Aucun micro trouvé" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="Branchez un micro ou un casque-micro : se7en Voice le détecte tout seul." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding MicFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE896;" Content="Installer" Click="InstallCable_Click" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding CableFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" IsEnabled="{Binding InstallingCable, Converter={x:Static vm:Converters.Not}}" />
                                                <c:Led DockPanel.Dock="Left" Round="True" Width="10" Height="10" Margin="2,0,14,0">
                                                    <c:Led.Style>
                                                        <Style TargetType="c:Led">
                                                            <Setter Property="Tone" Value="{DynamicResource GreenBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CableFound}" Value="False"><Setter Property="Tone" Value="{DynamicResource RedBrush}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </c:Led.Style>
                                                </c:Led>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StrongText}">
                                                                <Setter Property="Text" Value="Seven Microphone installé" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CableFound}" Value="False"><Setter Property="Text" Value="Seven Microphone à installer" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="C'est le micro que Discord et vos jeux vont utiliser. Gratuit, environ 1 minute." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding CableFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Padding="0,10" Visibility="{Binding OutputOnCable, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE7F6;" Content="Remettre mon casque" Click="FixOutput_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <c:Led DockPanel.Dock="Left" Round="True" Width="10" Height="10" Margin="2,0,14,0" Tone="{DynamicResource RedBrush}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Le son du PC part dans le micro virtuel" Style="{StaticResource StrongText}" FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap" />
                                                    <TextBlock Text="Vous n'entendez plus rien dans votre casque, et vos amis entendent tout votre PC. Un clic pour corriger." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="{Binding CableInstallStatus}" Style="{StaticResource StrongText}" Foreground="{DynamicResource TextStrongBrush}" TextWrapping="Wrap" Margin="24,0,0,8"
                                                   Visibility="{Binding CableInstallStatus, Converter={x:Static vm:Converters.NotEmptyToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Tout est prêt : le rappel de quoi choisir dans Discord -->
                                <Border DockPanel.Dock="Top" Style="{StaticResource Well}" Padding="16,10" Margin="0,0,8,14"
                                        Visibility="{Binding ReadyForDiscord, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Comment faire ?" Click="GoSettings_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <c:Led DockPanel.Dock="Left" Round="True" Width="10" Height="10" Margin="2,0,14,0" Tone="{DynamicResource GreenBrush}" />
                                        <TextBlock Style="{StaticResource StrongText}" TextWrapping="Wrap">
                                            <Run Text="Prêt pour Discord." FontFamily="{StaticResource FontMedium}" Foreground="{DynamicResource TextStrongBrush}" />
                                            <Run Text="Micro (entrée) :" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text="{Binding CableName, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" />
                                            <Run Text="· sortie : votre casque" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>

                                <!-- Rayons (contrôle segmenté) -->
                                <Border DockPanel.Dock="Top" Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,8,12">
                                    <ItemsControl ItemsSource="{Binding PresetFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource SegItem}" Content="{Binding}" GroupName="PresetFilter" Checked="Filter_Checked" Loaded="Filter_Loaded" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                        <ItemsControl ItemsSource="{Binding VisiblePresets}" ItemTemplate="{StaticResource VoiceTile}" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><c:AutoGrid MinItemWidth="215" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="AUCUNE VOIX TROUVÉE" Style="{StaticResource TitleText}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" Visibility="{Binding NoPresetMatch, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Colonne de droite : analyseur, réglages de la voix, entrée micro -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Analyseur -->
                                <Border Style="{StaticResource Well}" Padding="0" Height="132" ClipToBounds="True" Margin="0,0,0,10" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <c:SpectrumView x:Name="Spectrum" Margin="1" />
                                        <TextBlock c:Ui.Caps="Sortie voix" Style="{StaticResource LabelText}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,10,0,0" />
                                        <TextBlock Text="{Binding LatencyText}" Style="{StaticResource MetaText}" FontSize="11.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,12,0" />
                                        <TextBlock Text="60 Hz" Style="{StaticResource MetaText}" FontSize="10.5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,6" />
                                        <TextBlock Text="14 kHz" Style="{StaticResource MetaText}" FontSize="10.5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,6" />
                                    </Grid>
                                </Border>

                                <!-- Réglages de la voix (plateau) -->
                                <Border Style="{StaticResource Tray}">
                                    <StackPanel>
                                        <DockPanel Margin="6,2,4,8">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding EffectsOn}" ToolTip="Coupez pour entendre votre vraie voix (A/B, Ctrl + Alt + B)" />
                                            <TextBlock c:Ui.Caps="Voix modifiée" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextOnTrayBrush}" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Panel}" Padding="14,12,14,8">
                                            <StackPanel>
                                                <Border Style="{StaticResource Grip}" Margin="0,-6,0,4" />
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource InfoBadge}" Visibility="{Binding Modified, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock c:Ui.Caps="Modifiée" Style="{StaticResource BadgeText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding CurrentPresetName}" FontFamily="{StaticResource FontSemi}" FontSize="20" Foreground="{DynamicResource TextStrongBrush}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding CurrentPresetTagline}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />
                                                <UniformGrid Columns="1" Margin="-4,0,-4,0">
                                                    <UniformGrid.Resources>
                                                        <Style TargetType="c:ValueBar" BasedOn="{StaticResource {x:Type c:ValueBar}}">
                                                            <Setter Property="Margin" Value="4,0,4,4" />
                                                        </Style>
                                                    </UniformGrid.Resources>
                                                    <c:ValueBar Label="Hauteur" Minimum="-12" Maximum="12" Origin="0" Tick="1" Value="{Binding PitchSemitones}" Format="{}{0:+0;-0;0} st" />
                                                    <c:ValueBar Label="Grave" Value="{Binding Depth}" ToolTip="Voix plus grave et posée, en restant naturelle" />
                                                    <c:ValueBar Label="Volume" Minimum="-12" Maximum="20" Origin="0" Value="{Binding VolumeDb}" Format="{}{0:+0.0;-0.0;0.0} dB" />
                                                    <c:ValueBar Label="Timbre" Minimum="-12" Maximum="12" Origin="0" Tick="0.5" Value="{Binding FormantSemitones}" Format="{}{0:+0.0;-0.0;0.0}"
                                                            ToolTip="Homme ↔ femme, enfant, géant" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}" />
                                                </UniformGrid>
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource SmallGhostButton}" Content="Réinitialiser" Click="ResetEffects_Click" Margin="-10,0,0,0" />
                                                    <Button Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE74E;" Content="Enregistrer" Click="SavePreset_Click" Margin="0"
                                                            HorizontalAlignment="Right" ToolTip="Enregistrer ces réglages comme preset" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Réduction de bruit IA -->
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Réduction de bruit IA" Margin="0,10,0,0">
                                    <HeaderedContentControl.Tag>
                                        <Border Style="{StaticResource InfoBadge}" Visibility="{Binding DenoiseOn, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource BadgeDot}" />
                                                <TextBlock c:Ui.Caps="Active" Style="{StaticResource BadgeText}" />
                                            </StackPanel>
                                        </Border>
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource SettingRow}">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding DenoiseOn}" Margin="0,0,10,0" />
                                            <TextBlock Text="Supprimer clavier, ventilo, souffle" Style="{StaticResource StrongText}" />
                                        </DockPanel>
                                        <c:ParamSlider Label="Intensité" Value="{Binding DenoiseAmount}" Tone="{DynamicResource CyanBrush}" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <!-- Entrée micro -->
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Entrée micro" Margin="0,10,0,0">
                                    <StackPanel>
                                        <c:LevelMeter Height="4" Value="{Binding InputLevel}" Segments="42" />
                                        <c:LevelMeter Height="4" Value="{Binding OutputLevel}" Segments="42" Margin="0,8,0,0" />
                                        <DockPanel Margin="0,6,0,14">
                                            <TextBlock DockPanel.Dock="Right" Text="TRAITÉ" Style="{StaticResource MetaText}" FontSize="11.5" />
                                            <TextBlock Text="BRUT" Style="{StaticResource MetaText}" FontSize="11.5" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SettingRow}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MonitorOn}" />
                                            <TextBlock Text="S'écouter dans le casque" Style="{StaticResource StrongText}" ToolTip="Mettez un casque pour éviter le larsen" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SettingRow}" Margin="0">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding KeepFormants}" />
                                            <TextBlock Text="Timbre naturel" Style="{StaticResource StrongText}" ToolTip="Change la hauteur sans effet « chipmunk »" />
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- ========== TABLE DE MIXAGE ========== -->
                <DockPanel x:Name="PageMixer" Visibility="Collapsed" DataContext="{Binding Mixer}">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding DataContext, ElementName=PageVoice}">
                            <Border Style="{StaticResource InfoBadge}" Visibility="{Binding EffectsOn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}"><Run Text="VOIX · " /><Run Text="{Binding CurrentPresetName, Mode=OneWay, Converter={x:Static c:Caps.Instance}}" /></TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MIXAGE" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <TextBlock Style="{StaticResource MetaText}"><Run Text="Sortie Windows ·" /> <Run Text="{Binding MasterName, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <TextBlock Text="Le volume de votre micro et de chaque appli (jeux, musique, Discord) : glissez un fader vers le haut ou le bas." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border DockPanel.Dock="Top" Style="{StaticResource Well}" Padding="16,10" Margin="0,0,0,12" DataContext="{Binding DataContext, ElementName=PageVoice}"
                            Visibility="{Binding OutputOnCable, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE7F6;" Content="Remettre mon casque" Click="FixOutput_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <c:Led DockPanel.Dock="Left" Round="True" Width="10" Height="10" Margin="2,0,14,0" Tone="{DynamicResource RedBrush}" />
                            <TextBlock Style="{StaticResource StrongText}" TextWrapping="Wrap"><Run Text="Le son du PC part dans le micro virtuel." FontFamily="{StaticResource FontMedium}" Foreground="{DynamicResource TextStrongBrush}" /> <Run Text="Vous n'entendez plus rien et vos amis entendent tout votre PC." /></TextBlock>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Entrées -->
                                        <Border Style="{StaticResource Tray}">
                                            <StackPanel>
                                                <TextBlock c:Ui.Caps="Entrées" Style="{StaticResource TrayLabel}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Micro -->
                                                    <Border Style="{StaticResource Strip}" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" Style="{StaticResource InfoBadge}" Height="16" Padding="4,0" Visibility="{Binding EffectsOn, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="FX" Style="{StaticResource BadgeText}" FontSize="10.5" />
                                                                </Border>
                                                                <c:Led Tone="{DynamicResource ToneSky}" Margin="0,0,7,0" />
                                                                <TextBlock c:Ui.Caps="Micro" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextStrongBrush}" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding SelectedMicrophone.Name, FallbackValue='—'}" Style="{StaticResource StripDevice}" ToolTip="{Binding SelectedMicrophone.Name}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <c:Fader Height="240" Minimum="-12" Maximum="20" Zero="0" Value="{Binding VolumeDb}" Tone="{DynamicResource ToneSky}" IsMuted="{Binding Muted}" />
                                                                <c:LevelMeter Style="{StaticResource StripMeter}" Value="{Binding InputLevel}" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource ReadoutChip}" Margin="0,10,0,10"><TextBlock Text="{Binding VolumeDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" /></Border>
                                                            <ToggleButton Style="{StaticResource DangerIconToggle}" Width="30" Height="30" FontSize="13" Content="&#xE74F;" IsChecked="{Binding Muted}"
                                                                          HorizontalAlignment="Center" ToolTip="Muet (Ctrl + Alt + M)" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Tranches par type d'appli -->
                                                    <ItemsControl ItemsSource="{Binding VisibleChannels}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:MixerChannel}">
                                                                <Border Style="{StaticResource Strip}" ToolTip="{Binding Summary}">
                                                                    <StackPanel>
                                                                        <DockPanel>
                                                                            <c:Led Tone="{Binding ToneBrush}" Margin="0,0,7,0" />
                                                                            <TextBlock Text="{Binding Category, Converter={x:Static c:Caps.Instance}, ConverterParameter=tight}" Style="{StaticResource LabelText}" FontSize="12" Foreground="{DynamicResource TextStrongBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource StripDevice}" />
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                            <c:Fader Height="240" Minimum="0" Maximum="1" Zero="1" Value="{Binding Volume}" Tone="{Binding ToneBrush}" IsMuted="{Binding Muted}" />
                                                                            <c:LevelMeter Style="{StaticResource StripMeter}" Value="{Binding Level}" />
                                                                        </StackPanel>
                                                                        <Border Style="{StaticResource ReadoutChip}" Margin="0,10,0,10"><TextBlock Text="{Binding Volume, StringFormat='{}{0:P0}'}" /></Border>
                                                                        <ToggleButton Style="{StaticResource DangerIconToggle}" Width="30" Height="30" FontSize="13" Content="&#xE74F;" IsChecked="{Binding Muted}"
                                                                                      HorizontalAlignment="Center" ToolTip="Couper toute la tranche" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Sorties -->
                                        <Border Style="{StaticResource Tray}" Margin="10,0,0,0">
                                            <StackPanel>
                                                <TextBlock c:Ui.Caps="Sorties" Style="{StaticResource TrayLabel}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Strip}" ToolTip="{Binding MasterName}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                                                                                <TextBlock c:Ui.Caps="Casque" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextStrongBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding MasterName}" Style="{StaticResource StripDevice}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <c:Fader Height="240" Minimum="0" Maximum="1" Value="{Binding MasterVolume}" IsMuted="{Binding MasterMuted}" />
                                                                <c:LevelMeter Style="{StaticResource StripMeter}" Value="{Binding MasterLevel}" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource ReadoutChip}" Margin="0,10,0,10"><TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}" /></Border>
                                                            <ToggleButton Style="{StaticResource DangerIconToggle}" Width="30" Height="30" FontSize="13" Content="&#xE74F;" IsChecked="{Binding MasterMuted}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Strip}" Margin="0" ToolTip="Le son des applis que vous envoyez dans votre micro">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                                                                                <TextBlock c:Ui.Caps="Vos amis" Style="{StaticResource LabelText}" Foreground="{DynamicResource TextStrongBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="Vos amis l'entendent" Style="{StaticResource StripDevice}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <c:Fader Height="240" Minimum="-30" Maximum="6" Zero="0" Value="{Binding AppsToMicDb}" />
                                                                <c:LevelMeter Style="{StaticResource StripMeter}" Value="{Binding AppsToMicLevel}" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource ReadoutChip}" Margin="0,10,0,10"><TextBlock Text="{Binding AppsToMicDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" /></Border>
                                                            <Border Height="24" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Applis qui font du son -->
                                <Border Style="{StaticResource Panel}" Padding="12,12,12,6">
                                    <StackPanel>
                                        <TextBlock c:Ui.Caps="Applis qui font du son" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding VisibleChannels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MixerChannel}">
                                                    <ItemsControl ItemsSource="{Binding Apps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:MixerApp}">
                                                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" MinWidth="120" />
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="160" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="140" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <c:Led Tone="{Binding ToneBrush}" Margin="2,0,12,0" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource StrongText}" FontFamily="{StaticResource FontMedium}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                                            <TextBlock Text="{Binding Category}" Style="{StaticResource MetaText}" FontSize="11.5" />
                                                                        </StackPanel>
                                                                        <c:LevelMeter Grid.Column="2" Height="4" Value="{Binding Level}" Segments="18" Margin="0,0,14,0" VerticalAlignment="Center" />
                                                                        <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding Volume}" Tag="{Binding ToneBrush}" VerticalAlignment="Center" />
                                                                        <ToggleButton Grid.Column="4" Style="{StaticResource DangerIconToggle}" Width="30" Height="30" FontSize="13" IsChecked="{Binding Muted}"
                                                                                      Content="&#xE74F;" ToolTip="Couper cette appli" Margin="10,0,6,0" />
                                                                        <ToggleButton Grid.Column="5" Style="{StaticResource SmallKeyToggle}" IsChecked="{Binding ToMic}" Content="→ Micro"
                                                                                      ToolTip="Envoie le son de cette appli dans votre micro : vos amis l'entendent"
                                                                                      Visibility="{Binding CanSendToMic, Converter={StaticResource BoolToVis}}" />
                                                                        <ComboBox Grid.Column="6" ItemsSource="{Binding Categories}" SelectedItem="{Binding MoveTo}" Height="28" FontSize="12" ToolTip="Changer de tranche" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Colonne de droite -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Réduction de bruit IA" c:Ui.Subtitle="Clavier, ventilo, souffle"
                                                        DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DenoiseOn}" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <c:ParamSlider Label="Intensité" Value="{Binding DenoiseAmount}" Tone="{DynamicResource CyanBrush}" />
                                        <c:LevelMeter Height="4" Value="{Binding InputLevel}" Segments="34" Margin="0,12,0,0" />
                                        <c:LevelMeter Height="4" Value="{Binding OutputLevel}" Segments="34" Margin="0,8,0,0" />
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="TRAITÉ" Style="{StaticResource MetaText}" FontSize="11.5" />
                                            <TextBlock Text="BRUT" Style="{StaticResource MetaText}" FontSize="11.5" />
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Voix active" Margin="0,10,0,0" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EffectsOn}" ToolTip="Voix modifiée allumée / coupée" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentPresetName}" FontFamily="{StaticResource FontSemi}" FontSize="20" Foreground="{DynamicResource TextStrongBrush}" TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,10,0,0">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + →" /></Border>
                                            <TextBlock Text="Voix suivante" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Button Style="{StaticResource SmallSecondaryButton}" Content="Changer de voix" c:Ui.Icon="&#xE76C;" Click="GoVoice_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Musique plus basse" Margin="0,10,0,0" c:Ui.Subtitle="Baisse la musique automatiquement quand on parle">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource SettingRow}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DuckOnMyVoice}" />
                                            <TextBlock Text="Quand je parle" Style="{StaticResource StrongText}" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SettingRow}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DuckOnFriends}" />
                                            <TextBlock Text="Quand mes amis parlent" Style="{StaticResource StrongText}" />
                                        </DockPanel>
                                        <c:ParamSlider Label="Force de la baisse" Value="{Binding DuckAmount}" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Écoute" Margin="0,10,0,0" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MonitorOn}" ToolTip="Vous entendre dans votre casque" />
                                    </HeaderedContentControl.Tag>
                                    <ComboBox ItemsSource="{Binding Speakers}" SelectedValue="{Binding SelectedMonitor}" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- ========== EFFETS ========== -->
                <DockPanel x:Name="PageEffects" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource SmallKeyToggle}" IsChecked="{Binding Bypass}" Content="A/B" c:Ui.Icon="&#xE8AB;" Margin="0,0,6,0"
                                          ToolTip="Entendez votre vraie voix pour comparer (Ctrl + Alt + B)" />
                            <Button Style="{StaticResource SmallGhostButton}" Content="Réinitialiser" Click="ResetEffects_Click" />
                            <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE74E;" Content="Enregistrer" Click="SavePreset_Click" Margin="0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EFFETS" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <TextBlock Style="{StaticResource MetaText}"><Run Text="Voix de base ·" /> <Run Text="{Binding CurrentPresetName, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" /></TextBlock>
                            </StackPanel>
                            <TextBlock Text="Cochez la case d'un effet pour l'allumer, puis réglez ses barres. Les effets s'ajoutent à la voix choisie." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Chaîne active, façon routage -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Well}" Padding="12,8,12,2" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock c:Ui.Caps="Effets allumés" Style="{StaticResource MicroText}" Margin="0,4,14,0" VerticalAlignment="Top" />
                            <ItemsControl ItemsSource="{Binding ActiveChain}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource BorderStrongBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock Text="{Binding Converter={x:Static c:Caps.Instance}}" Style="{StaticResource BadgeText}" />
                                            </Border>
                                            <TextBlock Text="//" Style="{StaticResource MetaText}" FontSize="11.5" Margin="6,0,6,0" Foreground="{DynamicResource TextDisabledBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <StackPanel.Resources>
                                <Style TargetType="c:AutoGrid">
                                    <Setter Property="MinItemWidth" Value="300" />
                                    <Setter Property="Margin" Value="0,0,-6,-6" />
                                </Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Tray}">
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource Enable}" />
                            </StackPanel.Resources>

                            <Border>
                                <StackPanel>
                                    <TextBlock c:Ui.Caps="Nettoyage" Style="{StaticResource TrayLabel}" />
                                    <c:AutoGrid>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Anti-bruit" c:Ui.Subtitle="Coupe le micro entre vos phrases">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding GateOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Seuil" Minimum="-80" Maximum="-20" Tick="1" Value="{Binding GateThresholdDb}" Format="{}{0} dB" /></StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Réduction de bruit IA" c:Ui.Subtitle="Efface le bruit de fond, même pendant la parole">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding DenoiseOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Intensité" Value="{Binding DenoiseAmount}" Tone="{DynamicResource CyanBrush}" /></StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Coupe-bas" c:Ui.Subtitle="Vibrations, chocs sur le bureau, « pop »">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding LowCutOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Fréquence" Minimum="20" Maximum="300" Tick="1" Value="{Binding LowCutHz}" Format="{}{0} Hz" /></StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="De-esser" c:Ui.Subtitle="Adoucit les « sss » qui sifflent">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding DeEsserOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Force" Value="{Binding DeEsserAmount}" /></StackPanel>
                                        </HeaderedContentControl>
                                    </c:AutoGrid>
                                </StackPanel>
                            </Border>

                            <Border>
                                <StackPanel>
                                    <TextBlock c:Ui.Caps="Hauteur et timbre" Style="{StaticResource TrayLabel}" />
                                    <c:AutoGrid>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Hauteur" c:Ui.Subtitle="La note de la voix, sans changer le débit">
                                            <StackPanel>
                                                <c:ValueBar Label="Demi-tons" Minimum="-12" Maximum="12" Origin="0" Tick="1" Value="{Binding PitchSemitones}" Format="{}{0:+0;-0;0} st" />
                                                <c:ValueBar Label="Grave" Value="{Binding Depth}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Timbre" c:Ui.Subtitle="Allumé = timbre naturel (sans « chipmunk »)">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding KeepFormants}" ToolTip="Timbre naturel" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Timbre" Minimum="-12" Maximum="12" Origin="0" Tick="0.5" Value="{Binding FormantSemitones}" Format="{}{0:+0.0;-0.0;0.0}" /></StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Autotune" c:Ui.Subtitle="Vitesse au max = effet T-Pain">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding AutotuneOn}" /></HeaderedContentControl.Tag>
                                            <DockPanel>
                                                <c:ValueBar DockPanel.Dock="Left" Label="Vitesse" Value="{Binding AutotuneSpeed}" Width="170" Margin="0,0,10,0" />
                                                <StackPanel VerticalAlignment="Top">
                                                    <ComboBox ItemsSource="{Binding KeyNames}" SelectedIndex="{Binding AutotuneKey}" Height="28" FontSize="12" Margin="0,0,0,6" ToolTip="Tonalité" />
                                                    <ComboBox ItemsSource="{Binding ScaleNames}" SelectedIndex="{Binding AutotuneScale}" Height="28" FontSize="12" ToolTip="Gamme" />
                                                    <TextBlock Style="{StaticResource MetaText}" Margin="2,8,0,0">
                                                        <Run Text="NOTE" /> <Run Text="{Binding DetectedNote, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Harmoniseur" c:Ui.Subtitle="2ᵉ voix : -12 = monstre, +7 = chœur">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding HarmonyOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Intervalle" Minimum="-12" Maximum="12" Origin="0" Tick="1" Value="{Binding HarmonySemitones}" Format="{}{0:+0;-0;0} st" />
                                                <c:ValueBar Label="Mix" Value="{Binding HarmonyMix}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </c:AutoGrid>
                                </StackPanel>
                            </Border>

                            <Border>
                                <StackPanel>
                                    <TextBlock c:Ui.Caps="Caractère" Style="{StaticResource TrayLabel}" />
                                    <c:AutoGrid>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Robot · alien" c:Ui.Subtitle="Fréquence basse = robot, haute = alien">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding RobotOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Fréquence" Minimum="20" Maximum="800" Tick="1" Value="{Binding RobotFrequency}" Format="{}{0} Hz" />
                                                <c:ValueBar Label="Mix" Value="{Binding RobotMix}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Chuchotement" c:Ui.Subtitle="La voix devient un souffle">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding WhisperOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Souffle" Value="{Binding WhisperAmount}" /></StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Vibrato" c:Ui.Subtitle="Voix qui tremble (papy, fantôme)">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding VibratoOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Vitesse" Minimum="0.5" Maximum="12" Value="{Binding VibratoRate}" Format="{}{0:0.0} Hz" />
                                                <c:ValueBar Label="Profondeur" Value="{Binding VibratoDepth}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Saturation" c:Ui.Subtitle="Voix saturée, démon ou mégaphone">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding DistortionOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Drive" Value="{Binding DistortionDrive}" /></StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Bitcrusher" c:Ui.Subtitle="Son de vieille console de jeu">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding BitcrushOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Bits" Minimum="2" Maximum="16" Tick="1" Value="{Binding BitcrushBits}" Format="{}{0} bits" />
                                                <c:ValueBar Label="Échant." Minimum="1000" Maximum="24000" Value="{Binding BitcrushRateHz}" Format="{}{0:0} Hz" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Radio · talkie" c:Ui.Subtitle="Talkie-walkie ou vieille radio">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding RadioOn}" /></HeaderedContentControl.Tag>
                                            <TextBlock Text="Pas de réglage : allumez, c'est prêt." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        </HeaderedContentControl>
                                    </c:AutoGrid>
                                </StackPanel>
                            </Border>

                            <Border>
                                <StackPanel>
                                    <TextBlock c:Ui.Caps="Couleur et dynamique" Style="{StaticResource TrayLabel}" />
                                    <c:AutoGrid>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Égaliseur 5 bandes" c:Ui.Subtitle="Chaleur, clarté, présence">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding EqOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <StackPanel.Resources>
                                                    <Style TargetType="c:ValueBar" BasedOn="{StaticResource {x:Type c:ValueBar}}">
                                                        <Setter Property="Minimum" Value="-12" />
                                                        <Setter Property="Maximum" Value="12" />
                                                        <Setter Property="Origin" Value="0" />
                                                        <Setter Property="Format" Value="{}{0:+0;-0;0}" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <c:ValueBar Label="Low" Value="{Binding EqLowDb}" ToolTip="Graves" />
                                                <c:ValueBar Label="L-Mid" Value="{Binding EqLowMidDb}" ToolTip="Bas-médiums" />
                                                <c:ValueBar Label="Mid" Value="{Binding EqMidDb}" ToolTip="Médiums" />
                                                <c:ValueBar Label="Pres." Value="{Binding EqPresenceDb}" ToolTip="Présence" />
                                                <c:ValueBar Label="High" Value="{Binding EqHighDb}" ToolTip="Aigus" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Filtre" c:Ui.Subtitle="Téléphone, sous l'eau, derrière un mur">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding FilterOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Coupe sous" Minimum="20" Maximum="2000" Tick="10" Value="{Binding FilterLowHz}" Format="{}{0} Hz" />
                                                <c:ValueBar Label="Coupe dessus" Minimum="300" Maximum="16000" Tick="10" Value="{Binding FilterHighHz}" Format="{}{0} Hz" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Compresseur" c:Ui.Subtitle="Volume régulier, voix « radio »">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding CompressorOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel><c:ValueBar Label="Intensité" Value="{Binding CompressorAmount}" /></StackPanel>
                                        </HeaderedContentControl>
                                    </c:AutoGrid>
                                </StackPanel>
                            </Border>

                            <Border>
                                <StackPanel>
                                    <TextBlock c:Ui.Caps="Espace" Style="{StaticResource TrayLabel}" />
                                    <c:AutoGrid>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Chorus" c:Ui.Subtitle="Plusieurs voix à la fois, son plus large">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding ChorusOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Vitesse" Minimum="0.05" Maximum="5" Value="{Binding ChorusRate}" Format="{}{0:0.00} Hz" />
                                                <c:ValueBar Label="Profondeur" Value="{Binding ChorusDepth}" />
                                                <c:ValueBar Label="Mix" Value="{Binding ChorusMix}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Écho" c:Ui.Subtitle="La voix se répète… se répète…">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding EchoOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Délai" Minimum="40" Maximum="1000" Tick="1" Value="{Binding EchoTimeMs}" Format="{}{0} ms" />
                                                <c:ValueBar Label="Retour" Maximum="0.9" Value="{Binding EchoFeedback}" />
                                                <c:ValueBar Label="Mix" Value="{Binding EchoMix}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Style="{StaticResource Module}" Header="Réverb" c:Ui.Subtitle="Comme dans une grande salle">
                                            <HeaderedContentControl.Tag><ToggleButton IsChecked="{Binding ReverbOn}" /></HeaderedContentControl.Tag>
                                            <StackPanel>
                                                <c:ValueBar Label="Taille" Value="{Binding ReverbSize}" />
                                                <c:ValueBar Label="Mix" Value="{Binding ReverbMix}" />
                                            </StackPanel>
                                        </HeaderedContentControl>
                                    </c:AutoGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ========== SOUNDBOARD ========== -->
                <DockPanel x:Name="PageSounds" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallDangerButton}" c:Ui.Icon="&#xE71A;" Content="Tout arrêter" Click="StopSounds_Click" ToolTip="Ctrl + Alt + 0" />
                            <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE710;" Content="Ajouter un son" Click="AddSounds_Click" Margin="0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SONS" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <TextBlock Style="{StaticResource MetaText}"><Run Text="{Binding Sounds.Count, Mode=OneWay}" /><Run Text=" sons · Ctrl + Alt + 1 à 9" /></TextBlock>
                            </StackPanel>
                            <TextBlock Text="Cliquez sur un son pour le jouer dans votre micro. Glissez des fichiers audio dans la fenêtre pour en ajouter." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" Padding="12,12,6,6">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Sounds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><c:AutoGrid MinItemWidth="175" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SoundItem}">
                                                <Grid Height="140" Margin="0,0,8,8">
                                                    <Button Click="PlaySound_Click" Tag="{Binding}" Cursor="Hand" Focusable="False" RenderTransformOrigin="0.5,0.5">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Style="{StaticResource Raised}" Padding="10" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                                                    <DockPanel>
                                                                        <DockPanel DockPanel.Dock="Top">
                                                                            <c:Led Tone="{Binding ToneBrush}" Width="10" Height="10" />
                                                                            <Border Style="{StaticResource KeyChip}" Margin="0,0,22,0" HorizontalAlignment="Right"
                                                                                    Visibility="{Binding Hotkey, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
                                                                                <TextBlock Text="{Binding Hotkey}" />
                                                                            </Border>
                                                                        </DockPanel>
                                                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontFamily="{StaticResource FontSemi}" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="20" HorizontalAlignment="Center" Opacity="0.8" />
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource InverseBrush}" />
                                                                        <Setter TargetName="b" Property="Effect" Value="{DynamicResource SelectedGlow}" />
                                                                        <Setter TargetName="b" Property="TextElement.Foreground" Value="{DynamicResource TextInverseBrush}" />
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostIconButton}" Width="20" Height="20" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                            Content="&#xE711;" Click="RemoveSound_Click" Tag="{Binding}" ToolTip="Retirer" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- État vide : cadre HUD -->
                                <Grid x:Name="SoundsEmpty" Visibility="{Binding Sounds.Count, Converter={x:Static vm:Converters.ZeroToVisibility}}" Margin="0,0,6,6">
                                    <c:HudFrame Chamfer="20" Stroke="{DynamicResource HudLineBrush}" Fill="{DynamicResource WellBrush}" Padding="36,30" Width="460"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="AUCUN SON" Style="{StaticResource TitleText}" FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,6" />
                                            <TextBlock Text="Glissez des fichiers WAV, MP3 ou OGG ici. Ils sont joués dans votre micro." Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        </StackPanel>
                                    </c:HudFrame>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Sortie des sons -->
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock c:Ui.Caps="Sortie" Style="{StaticResource LabelText}" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <c:Fader Height="300" Minimum="-30" Maximum="6" Zero="0" Value="{Binding SoundVolumeDb}" />
                                </StackPanel>
                                <Border Style="{StaticResource ReadoutChip}" Margin="0,10,0,4"><TextBlock Text="{Binding SoundVolumeDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" /></Border>
                                <TextBlock c:Ui.Caps="Volume" Style="{StaticResource MicroText}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SoundsToMonitor}" />
                                    <TextBlock Text="Casque aussi" Style="{StaticResource CaptionText}" VerticalAlignment="Center" ToolTip="Entendre aussi les sons dans votre casque" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ========== PARAMÈTRES ========== -->
                <DockPanel x:Name="PageSettings" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RÉGLAGES" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <TextBlock Text="Le micro virtuel pour Discord, vos périphériques et les raccourcis clavier." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Seven Microphone" c:Ui.Subtitle="Le micro virtuel de Discord et de vos jeux">
                                    <HeaderedContentControl.Tag>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DangerBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CableFound}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                                                            <Setter Property="Background" Value="#1A3EE08F" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource BadgeDot}" />
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                            <Setter Property="Text" Value="ABSENT" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CableFound}" Value="True">
                                                                    <Setter Property="Text" Value="ACTIF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding CableFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                                       Text="Pour que Discord et vos jeux entendent votre voix modifiée, il faut un micro virtuel. se7en Voice installe « Seven Microphone » : il s'appuie sur le pilote gratuit VB-CABLE, téléchargé sur le site officiel de VB-Audio." />
                                            <TextBlock Style="{StaticResource StrongText}" TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="01" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextTertiaryBrush}" /> Cliquez sur « Installer »</TextBlock>
                                            <TextBlock Style="{StaticResource StrongText}" TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="02" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextTertiaryBrush}" /> Acceptez la demande de Windows, puis « Install Driver »</TextBlock>
                                            <TextBlock Style="{StaticResource StrongText}" TextWrapping="Wrap" Margin="0,0,0,14"><Run Text="03" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextTertiaryBrush}" /> C'est prêt (parfois après un redémarrage)</TextBlock>
                                            <TextBlock Text="{Binding CableInstallStatus}" Style="{StaticResource StrongText}" Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                                                       Visibility="{Binding CableInstallStatus, Converter={x:Static vm:Converters.NotEmptyToVisibility}}" />
                                            <WrapPanel>
                                                <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE896;" Content="Installer" Click="InstallCable_Click" Margin="0,0,6,6"
                                                        IsEnabled="{Binding InstallingCable, Converter={x:Static vm:Converters.Not}}" />
                                                <Button Style="{StaticResource SmallSecondaryButton}" Content="Vérifier" Click="CheckCable_Click" Margin="0,0,6,6" />
                                                <Button Style="{StaticResource SmallGhostButton}" Content="Site VB-CABLE" Click="DownloadCable_Click" Margin="0,0,6,6" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding CableFound, Converter={x:Static vm:Converters.BoolToVisibility}}">
                                            <TextBlock c:Ui.Caps="Dans Discord et vos jeux" Style="{StaticResource MicroText}" Margin="0,0,0,8" />
                                            <!-- Quoi mettre en entrée et en sortie -->
                                            <Border Style="{StaticResource Well}" Padding="12,4">
                                                <StackPanel>
                                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left" Style="{StaticResource SolidBadge}" Width="64" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                <TextBlock Text="ENTRÉE" Style="{StaticResource BadgeText}" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding CableName}" Style="{StaticResource StrongText}" Foreground="{DynamicResource TextStrongBrush}" FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap" />
                                                                <TextBlock Text="Périphérique d'entrée (micro) : votre voix modifiée" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <DockPanel Margin="0,8">
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Width="64" Margin="0,0,12,0" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderStrongBrush}"
                                                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <TextBlock Text="SORTIE" Style="{StaticResource BadgeText}" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SelectedMonitor.Name, FallbackValue='Votre casque'}" Style="{StaticResource StrongText}" Foreground="{DynamicResource TextStrongBrush}" FontFamily="{StaticResource FontMedium}" TextWrapping="Wrap" />
                                                            <TextBlock Text="Périphérique de sortie : votre casque, comme d'habitude. Jamais « Seven Microphone - Sortie »." Style="{StaticResource CaptionText}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="Coupez aussi la suppression de bruit de Discord (Krisp) : se7en Voice s'en charge." />
                                            <StackPanel Visibility="{Binding CableRenamed, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10" TextWrapping="Wrap"
                                                           Text="Le micro virtuel porte encore son nom d'origine. Renommez-le pour voir clairement « Entrée » et « Sortie » dans Discord." />
                                                <Button Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Left" c:Ui.Icon="&#xE8AC;" Content="Renommer" Click="RenameCable_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Périphériques" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock c:Ui.Caps="Micro" Style="{StaticResource MicroText}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Microphones}" SelectedValue="{Binding SelectedMicrophone}" Margin="0,0,0,14" />
                                        <TextBlock c:Ui.Caps="Casque (A1)" Style="{StaticResource MicroText}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Speakers}" SelectedValue="{Binding SelectedMonitor}" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0"><TextBlock Text="WASAPI" Style="{StaticResource BadgeText}" FontFamily="{StaticResource FontMono}" /></Border>
                                            <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding RateText}" Style="{StaticResource BadgeText}" FontFamily="{StaticResource FontMono}" /></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Qualité audio" Margin="0,0,0,10" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                                    <c:HudFrame Chamfer="12" Stroke="{DynamicResource HudLineBrush}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ReadoutText}" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19">
                                                <Run Text="LATENCE ESTIMÉE" /> <Run Text="{Binding LatencyText, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource ReadoutText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0">
                                                <Run Text="FRÉQUENCE" /> <Run Text="{Binding RateText, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </c:HudFrame>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Appuyer pour parler" c:Ui.Subtitle="Le micro ne s'ouvre que quand vous tenez la touche (marche même en jeu)">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PushToTalkOn}" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource ReadoutChip}" MinWidth="110" Height="24" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PushToTalkKeyName}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Button Style="{StaticResource SmallSecondaryButton}" Content="Changer la touche" Click="CaptureKey_Click" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Général" Margin="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource SettingRow}">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Enable}" IsChecked="{Binding ExpertMode}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="Mode expert" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="Montre la page Effets, l'analyseur et les mesures techniques" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SettingRow}">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Enable}" IsChecked="{Binding StartWithWindows}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="Lancer au démarrage de Windows" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="La voix est prête dès que le PC s'allume" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SettingRow}" Margin="0">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Enable}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="Rester actif à la fermeture" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="La croix cache l'appli près de l'horloge" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Enregistrements" Margin="0,10,0,0" c:Ui.Subtitle="Ce qu'entendent vos amis, en .wav">
                                    <StackPanel>
                                        <Border Style="{StaticResource ReadoutChip}" HorizontalAlignment="Stretch" Margin="0,0,0,10" Padding="8,4">
                                            <TextBlock Text="{Binding RecordingsFolder}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding RecordingsFolder}" />
                                        </Border>
                                        <WrapPanel>
                                            <Button Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE838;" Content="Ouvrir le dossier" Click="OpenRecordings_Click" />
                                            <Button Style="{StaticResource SmallGhostButton}" Content="Changer" Click="ChooseRecordings_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>

                            <HeaderedContentControl Grid.Column="4" Style="{StaticResource Card}" Header="Raccourcis" VerticalAlignment="Top" c:Ui.Subtitle="Marchent même en jeu">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                        <Style x:Key="Row" TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="Padding" Value="0,8" />
                                        </Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StrongText}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + M" Style="{x:Null}" /></Border><TextBlock Text="Couper le micro" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + → / ←" Style="{x:Null}" /></Border><TextBlock Text="Voix suivante / précédente" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + F1…F9" Style="{x:Null}" /></Border><TextBlock Text="Voix favorite 1 à 9" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + N" Style="{x:Null}" /></Border><TextBlock Text="Voix normale" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + B" Style="{x:Null}" /></Border><TextBlock Text="A/B : effets coupés" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + R" Style="{x:Null}" /></Border><TextBlock Text="Enregistrer / arrêter" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + 1…9" Style="{x:Null}" /></Border><TextBlock Text="Jouer un son" /></DockPanel></Border>
                                    <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0"><TextBlock Text="Ctrl + Alt + 0" Style="{x:Null}" /></Border><TextBlock Text="Tout arrêter" /></DockPanel></Border>
                                </StackPanel>
                            </HeaderedContentControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ===== Voix rapides (favoris) ===== -->
            <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" c:Ui.Caps="Voix rapides" Style="{StaticResource MicroText}" Margin="2,0,12,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}" Content="Toutes les voix" c:Ui.Icon="&#xE76C;" Margin="0" Click="GoVoice_Click"
                        ToolTip="L'étoile d'une voix l'ajoute ici" />
                <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding QuickVoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PresetItem}">
                                <RadioButton Style="{StaticResource SegItem}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="QuickVoice_Click" Tag="{Binding}" GroupName="Quick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ===== Notification (Toast) ===== -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,64" Padding="14,12" CornerRadius="8"
                Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Width="360" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource PopShadow}">
            <DockPanel>
                <c:Led DockPanel.Dock="Left" Round="True" Tone="{DynamicResource OrangeBrush}" Margin="0,4,12,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontFamily="{StaticResource FontSemi}" FontSize="11" Foreground="{DynamicResource TextStrongBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Premier lancement : installer Seven Microphone ===== -->
        <Grid x:Name="CableDialog" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
            <c:HudFrame Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Chamfer="18" Fill="{DynamicResource Ink50Brush}" Stroke="{DynamicResource HudLineBrush}"
                        Padding="22,18,22,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="INSTALLER SEVEN MICROPHONE" Style="{StaticResource TitleText}" FontSize="13" />
                    </StackPanel>
                    <Grid Height="1" Margin="0,0,0,16">
                        <Border Background="{DynamicResource BorderBrush}" />
                        <Border Background="{DynamicResource HudLineBrush}" Width="40" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="C'est le micro à choisir dans Discord et vos jeux : ils entendront votre voix modifiée. Gratuit, environ 1 minute. Windows demandera l'autorisation, puis cliquez « Install Driver » dans la fenêtre VB-Audio." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Plus tard" Click="CableDialogLater_Click" />
                        <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="&#xE896;" Content="Installer" Click="CableDialogInstall_Click" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </c:HudFrame>
        </Grid>

        <!-- ===== Nouveau preset ===== -->
        <Grid x:Name="SaveDialog" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
            <c:HudFrame Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Chamfer="18" Fill="{DynamicResource Ink50Brush}" Stroke="{DynamicResource HudLineBrush}"
                        Padding="22,18,22,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="NOUVEAU PRESET" Style="{StaticResource TitleText}" FontSize="13" />
                    </StackPanel>
                    <Grid Height="1" Margin="0,0,0,16">
                        <Border Background="{DynamicResource BorderBrush}" />
                        <Border Background="{DynamicResource HudLineBrush}" Width="40" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Text="Enregistre les réglages actuels sous un nouveau nom." Style="{StaticResource BodyText}" Margin="0,0,0,12" />
                    <TextBlock c:Ui.Caps="Nom" Style="{StaticResource MicroText}" Margin="0,0,0,6" />
                    <TextBox x:Name="PresetNameBox" KeyDown="PresetNameBox_KeyDown" MaxLength="28" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="CancelSave_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="ConfirmSave_Click" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </c:HudFrame>
        </Grid>
    </Grid>
</Window>
