<Window x:Class="Se7enVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Se7enVoice.Controls"
        xmlns:vm="clr-namespace:Se7enVoice.ViewModels"
        Title="se7en Voice" Width="1440" Height="900" MinWidth="1240" MinHeight="780"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackdropBrush}"
        FontFamily="{StaticResource FontSans}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" AllowDrop="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="84" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- En-tête d'écran : titre 24 + sous-titre, actions à droite -->
        <Style x:Key="ScreenHead" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <!-- Libellé de section en petites capitales -->
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource MicroText}">
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>
        <Style TargetType="c:Knob">
            <Setter Property="Width" Value="72" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Module d'effet : tuile, Tag = interrupteur ; contour violet quand il est allumé -->
        <Style x:Key="ModuleCard" TargetType="HeaderedContentControl">
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border x:Name="b" Style="{StaticResource Tile}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Top" Margin="8,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource H3Text}" FontSize="16.5" />
                                        <TextBlock Text="{Binding (c:Ui.Subtitle), RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource TertiaryText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag.IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte de voix (VoiceCard) : puits d'icône, nom, catégorie ; active = irisée + coche violette -->
        <DataTemplate x:Key="VoiceCard" DataType="{x:Type vm:PresetItem}">
            <Grid Height="68" Margin="0,0,12,12">
                <Button Cursor="Hand" Focusable="False" Click="PresetTile_Click" Tag="{Binding}" RenderTransformOrigin="0.5,0.5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="22" Background="{DynamicResource GlassTileBrush}" BorderBrush="{DynamicResource GlassStrokeInnerBrush}"
                                    BorderThickness="1" Padding="10,10,44,10" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                <DockPanel>
                                    <Border Style="{StaticResource IconWell}" Width="46" Height="46" CornerRadius="15" Background="{Binding ToneBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="19" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontSemi}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="cat" Text="{Binding Tagline}" FontFamily="{StaticResource FontMedium}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource IridescentBrush}" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="#B3FFFFFF" />
                                    <Setter TargetName="b" Property="Effect" Value="{DynamicResource IridGlow}" />
                                    <Setter TargetName="b" Property="TextElement.Foreground" Value="#141416" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                            <MenuItem Header="Exporter (partager avec un ami)…" Click="ExportPreset_Click" Tag="{Binding}" />
                            <MenuItem Header="Supprimer" Click="DeletePreset_Click" Tag="{Binding}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!-- Coche violette (voix active) ou étoile -->
                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource VioletBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <ToggleButton Style="{StaticResource StarToggle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding IsFavorite, Mode=OneWay}" Click="Favorite_Click" Tag="{Binding}"
                              Visibility="{Binding IsSelected, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- Tranche de mixage (ChannelStrip) -->
        <Style x:Key="Strip" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Width" Value="98" />
            <Setter Property="Padding" Value="8,16,8,14" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>
        <Style x:Key="StripName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontSemi}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="StripDevice" TargetType="TextBlock" BasedOn="{StaticResource TertiaryText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,1,0,12" />
        </Style>
        <Style x:Key="DbChip" TargetType="Border" BasedOn="{StaticResource KeyChip}">
            <Setter Property="Margin" Value="0,12,0,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fond : taches de lumière -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource Leak1Brush}" />
            <Rectangle Fill="{DynamicResource Leak2Brush}" />
            <Rectangle Fill="{DynamicResource Leak3Brush}" />
            <Rectangle Fill="{DynamicResource Leak4Brush}" />
        </Grid>

        <Grid Margin="20,10,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Barre du haut flottante ===== -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource GlassPill}" Padding="24,0,10,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource FontSans}" FontWeight="Bold" FontSize="21" VerticalAlignment="Center">
                            <Run Text="se" /><Run Text="7" Foreground="{StaticResource VioletBrush}" /><Run Text="en Voice" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Style="{StaticResource SegBar}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegItem}" Content="Clair" c:Ui.Icon="&#xE706;" GroupName="Theme" IsChecked="{Binding IsLight}" />
                                <RadioButton Style="{StaticResource SegItem}" Content="Sombre" c:Ui.Icon="&#xE708;" GroupName="Theme" IsChecked="{Binding IsDark}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LiveBadge}" Margin="0,0,10,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,7,0" />
                                <TextBlock Style="{StaticResource BadgeText}"><Run Text="REC · " /><Run Text="{Binding RecordingTime, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Border>
                        <ToggleButton Margin="0,0,10,0" IsChecked="{Binding Muted}" ToolTip="Couper le micro (CTRL+ALT+M)">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DangerIconToggle}">
                                    <Setter Property="Content" Value="&#xE720;" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="&#xF781;" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button Click="Record_Click" MinWidth="168" ToolTip="Enregistre ce qu'entendent tes amis (CTRL+ALT+R)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Enregistrer" />
                                    <Setter Property="c:Ui.Icon" Value="&#xE7C8;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Content" Value="Arrêter" />
                                            <Setter Property="c:Ui.Icon" Value="&#xE71A;" />
                                            <Setter Property="Background" Value="{StaticResource GelRedBrush}" />
                                            <Setter Property="Tag" Value="{StaticResource GelRedBrush}" />
                                            <Setter Property="c:Ui.Glow" Value="{DynamicResource DangerGlow}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="1" Height="24" Background="{DynamicResource DividerBrush}" Margin="4,0,6,0" />
                        <Button Style="{StaticResource GhostIconButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Réduire" />
                        <Button Style="{StaticResource GhostIconButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Agrandir" />
                        <Button Style="{StaticResource GhostIconButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer" />
                    </StackPanel>

                    <!-- Recherche (voix) au centre -->
                    <Grid Width="420" HorizontalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox x:Name="SearchBox" Text="{Binding PresetSearch, UpdateSourceTrigger=PropertyChanged}" Padding="42,0,16,0" Background="{DynamicResource WellBrush}"
                                 BorderThickness="0" GotKeyboardFocus="SearchBox_GotFocus" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" Margin="18,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Rechercher une voix…" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="44,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== Rail d'icônes ===== -->
            <Border Grid.Row="2" Style="{StaticResource GlassPill}" VerticalAlignment="Center" Padding="8">
                <StackPanel>
                    <RadioButton x:Name="TabMixer" Style="{StaticResource RailItem}" Content="&#xE9E9;" ToolTip="Table de mixage" GroupName="Nav" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabVoice" Style="{StaticResource RailItem}" Content="&#xE720;" ToolTip="Voix" GroupName="Nav" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabEffects" Style="{StaticResource RailItem}" Content="&#xE945;" ToolTip="Effets" GroupName="Nav" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabSounds" Style="{StaticResource RailItem}" Content="&#xF0E2;" ToolTip="Soundboard" GroupName="Nav" Checked="Tab_Checked" />
                    <Border Width="24" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6" />
                    <RadioButton x:Name="TabSettings" Style="{StaticResource RailItem}" Content="&#xE713;" ToolTip="Réglages" GroupName="Nav" Checked="Tab_Checked" />
                </StackPanel>
            </Border>

            <!-- ===== Grand panneau ===== -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="26,24,14,10">
                <Grid>

                    <!-- ========== VOIX ========== -->
                    <Grid x:Name="PageVoice">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlassButton}" c:Ui.Icon="&#xE8B5;" Content="Importer" Click="ImportPreset_Click" ToolTip="Ajoute une voix envoyée par un ami (.json)" />
                                    <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="&#xE710;" Content="Créer une voix" Click="SavePreset_Click" Margin="0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Voix" Style="{StaticResource H2Text}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                        <Run Text="Modifie ta voix en direct, sur toutes les sorties ·" /> <Run Text="{Binding LibraryTitle, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <!-- Seven Microphone manquant -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource Tile}" Padding="14,12" Margin="0,0,12,16"
                                    Visibility="{Binding CableFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE896;" Content="Installer" Click="InstallCable_Click" Margin="0"
                                            IsEnabled="{Binding InstallingCable, Converter={x:Static vm:Converters.Not}}" />
                                    <Border Style="{StaticResource IconWell}" Background="{StaticResource GelRedBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE720;" Style="{StaticResource IconText}" FontSize="16" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Seven Microphone n'est pas installé" Style="{StaticResource LabelText}" FontFamily="{StaticResource FontSemi}" />
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                    <Setter Property="Text" Value="C'est le micro que Discord et tes jeux vont utiliser. Installation gratuite, environ 1 minute." />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CableInstallStatus, Converter={x:Static vm:Converters.IsNotEmpty}}" Value="True">
                                                            <Setter Property="Text" Value="{Binding CableInstallStatus}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PresetFilters}" Margin="-12,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource UnderlineTab}" Content="{Binding}" GroupName="PresetFilter" Checked="Filter_Checked" Loaded="Filter_Loaded" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding VisiblePresets}" ItemTemplate="{StaticResource VoiceCard}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><c:AutoGrid MinItemWidth="232" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Aucune voix trouvée" Style="{StaticResource H3Text}" Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoPresetMatch, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DockPanel>

                        <!-- Chaîne d'effets de la voix active -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <Border Style="{StaticResource Tile}" Padding="22,20" Margin="0,0,12,14">
                                <StackPanel>
                                    <TextBlock Text="CHAÎNE D'EFFETS" Style="{StaticResource MicroText}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource AccentSwitch}" IsChecked="{Binding EffectsOn}" VerticalAlignment="Top"
                                                      ToolTip="Coupe les effets pour entendre ta vraie voix (A/B, CTRL+ALT+B)" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentPresetName}" Style="{StaticResource H1Text}" FontSize="30" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding CurrentPresetTagline}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                <Border Style="{StaticResource Badge}" MinHeight="20" Padding="8,0" Margin="8,0,0,0" Visibility="{Binding Modified, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Modifiée" Style="{StaticResource BadgeText}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <UniformGrid Columns="2" Margin="0,22,0,10">
                                        <c:Knob Label="Pitch" Minimum="-12" Maximum="12" Origin="0" Tick="1" Value="{Binding PitchSemitones}" Format="{}{0:+0.0;-0.0;0.0} st" Tone="{StaticResource VioletBrush}" HorizontalAlignment="Center" />
                                        <c:Knob Label="Formant" Minimum="-12" Maximum="12" Origin="0" Tick="0.5" Value="{Binding FormantSemitones}" Format="{}{0:+0.0;-0.0;0.0}" Tone="{StaticResource MintBrush}" HorizontalAlignment="Center"
                                                ToolTip="Morphologie de la voix : homme ↔ femme, enfant, géant" />
                                        <c:Knob Label="Coffre" Value="{Binding Depth}" Tone="{StaticResource ToneRose}" HorizontalAlignment="Center" ToolTip="Voix plus grave et posée, en restant naturelle" />
                                        <c:Knob Label="Volume" Minimum="-12" Maximum="20" Origin="0" Value="{Binding VolumeDb}" Format="{}{0:+0.0;-0.0;0.0} dB" Tone="{StaticResource VioletBrush}" HorizontalAlignment="Center" />
                                    </UniformGrid>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="ENTRÉE" Style="{StaticResource MicroText}" Width="58" VerticalAlignment="Center" />
                                        <c:LevelMeter Height="5" Value="{Binding InputLevel}" Segments="36" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,16">
                                        <TextBlock Text="SORTIE" Style="{StaticResource MicroText}" Width="58" VerticalAlignment="Center" />
                                        <c:LevelMeter Height="5" Value="{Binding OutputLevel}" Segments="36" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,12">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SmallSwitch}" Tag="{StaticResource VioletBrush}" IsChecked="{Binding MonitorOn}" />
                                        <TextBlock Text="Écoute de contrôle" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                                                   ToolTip="T'entendre dans ton casque (mets un casque pour éviter le larsen)" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,12">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SmallSwitch}" Tag="{StaticResource VioletBrush}" IsChecked="{Binding KeepFormants}" />
                                        <TextBlock Text="Timbre naturel" Style="{StaticResource LabelText}" VerticalAlignment="Center" ToolTip="Change le pitch sans effet « chipmunk »" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,14">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SmallSwitch}" Tag="{StaticResource VioletBrush}" IsChecked="{Binding DenoiseOn}" />
                                        <TextBlock Text="Réduction de bruit IA" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border Style="{StaticResource Well}" Padding="12,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyText}" Style="{StaticResource ReadoutText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="SPECTRE" Style="{StaticResource MicroText}" />
                                            </DockPanel>
                                            <c:SpectrumView x:Name="Spectrum" Height="64" />
                                        </StackPanel>
                                    </Border>
                                    <DockPanel Margin="0,18,0,0">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource SmallGhostButton}" Content="Réinitialiser" Click="ResetEffects_Click" />
                                        <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE74E;" Content="Enregistrer" Click="SavePreset_Click" Margin="0" ToolTip="Enregistrer ces réglages comme preset" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== TABLE DE MIXAGE ========== -->
                    <Grid x:Name="PageMixer" Visibility="Collapsed" DataContext="{Binding Mixer}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="286" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}" Margin="0,0,12,20">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <Border Style="{StaticResource SuccessBadge}" Visibility="{Binding Live, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0" />
                                            <TextBlock Text="Moteur audio actif" Style="{StaticResource BadgeText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DangerBadge}" Visibility="{Binding Live, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                        <TextBlock Text="Micro inactif" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Table de mixage" Style="{StaticResource H2Text}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                        <Run Text="Sortie Windows :" /> <Run Text="{Binding MasterName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,12,10">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBlock Text="ENTRÉES" Style="{StaticResource Section}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Micro -->
                                                    <Border Style="{StaticResource Strip}" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource IconWell}" Background="{StaticResource ToneViolet}" HorizontalAlignment="Center">
                                                                <TextBlock Text="&#xE720;" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Micro" Style="{StaticResource StripName}" />
                                                            <TextBlock Text="{Binding SelectedMicrophone.Name, FallbackValue='—'}" Style="{StaticResource StripDevice}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <c:Fader Height="210" Minimum="-12" Maximum="20" Zero="0" Value="{Binding VolumeDb}" Tone="{StaticResource ToneViolet}" IsMuted="{Binding Muted}" />
                                                                <c:LevelMeter Width="5" Height="210" Vertical="True" Value="{Binding InputLevel}" Segments="30" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource DbChip}"><TextBlock Text="{Binding VolumeDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" /></Border>
                                                            <ToggleButton Style="{StaticResource MiniPill}" Content="M" IsChecked="{Binding Muted}" HorizontalAlignment="Center" ToolTip="Muet (CTRL+ALT+M)" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Tranches par type d'appli -->
                                                    <ItemsControl ItemsSource="{Binding VisibleChannels}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:MixerChannel}">
                                                                <Border Style="{StaticResource Strip}" ToolTip="{Binding Summary}">
                                                                    <StackPanel>
                                                                        <Border Style="{StaticResource IconWell}" Background="{Binding ToneBrush}" HorizontalAlignment="Center">
                                                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Category}" Style="{StaticResource StripName}" />
                                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource StripDevice}" />
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                            <c:Fader Height="210" Minimum="0" Maximum="1" Zero="1" Value="{Binding Volume}" Tone="{Binding ToneBrush}" IsMuted="{Binding Muted}" />
                                                                            <c:LevelMeter Width="5" Height="210" Vertical="True" Value="{Binding Level}" Segments="30" Margin="6,0,0,0" />
                                                                        </StackPanel>
                                                                        <Border Style="{StaticResource DbChip}"><TextBlock Text="{Binding Volume, StringFormat='{}{0:P0}'}" /></Border>
                                                                        <ToggleButton Style="{StaticResource MiniPill}" Content="M" IsChecked="{Binding Muted}" HorizontalAlignment="Center" ToolTip="Couper toute la tranche" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="2,28,11,0" />
                                            <StackPanel>
                                                <TextBlock Text="SORTIES" Style="{StaticResource Section}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Strip}" ToolTip="{Binding MasterName}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource IconWell}" Background="{StaticResource ToneNeutral}" HorizontalAlignment="Center">
                                                                <TextBlock Text="&#xE7F6;" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Casque" Style="{StaticResource StripName}" />
                                                            <TextBlock Text="{Binding MasterName}" Style="{StaticResource StripDevice}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <c:Fader Height="210" Minimum="0" Maximum="1" Value="{Binding MasterVolume}" Tone="{StaticResource ToneNeutral}" IsMuted="{Binding MasterMuted}" />
                                                                <c:LevelMeter Width="5" Height="210" Vertical="True" Value="{Binding MasterLevel}" Segments="30" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource DbChip}"><TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}" /></Border>
                                                            <ToggleButton Style="{StaticResource MiniPill}" Content="M" IsChecked="{Binding MasterMuted}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Strip}" ToolTip="Le son des applis que tu envoies dans ton micro">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource IconWell}" Background="{StaticResource ToneMint}" HorizontalAlignment="Center">
                                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconText}" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Vers le micro" Style="{StaticResource StripName}" />
                                                            <TextBlock Text="Tes amis l'entendent" Style="{StaticResource StripDevice}" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <c:Fader Height="210" Minimum="-30" Maximum="6" Zero="0" Value="{Binding AppsToMicDb}" Tone="{StaticResource ToneMint}" />
                                                                <c:LevelMeter Width="5" Height="210" Vertical="True" Value="{Binding AppsToMicLevel}" Segments="30" Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <Border Style="{StaticResource DbChip}"><TextBlock Text="{Binding AppsToMicDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" /></Border>
                                                            <Border Height="24" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <TextBlock Text="APPLIS QUI FONT DU SON" Style="{StaticResource Section}" Margin="2,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding VisibleChannels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MixerChannel}">
                                                <ItemsControl ItemsSource="{Binding Apps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MixerApp}">
                                                            <Border Style="{StaticResource Tile}" Padding="12,8" Margin="0,0,0,10" CornerRadius="18">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" MinWidth="120" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="160" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="150" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Style="{StaticResource IconWell}" Width="32" Height="32" CornerRadius="10" Background="{Binding ToneBrush}" Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="13" HorizontalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" FontFamily="{StaticResource FontSemi}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                                        <TextBlock Text="{Binding Category}" Style="{StaticResource TertiaryText}" />
                                                                    </StackPanel>
                                                                    <c:LevelMeter Grid.Column="2" Height="5" Value="{Binding Level}" Segments="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                    <Slider Grid.Column="3" Minimum="0" Maximum="1" Value="{Binding Volume}" Tag="{Binding ToneBrush}" VerticalAlignment="Center" />
                                                                    <ToggleButton Grid.Column="4" Style="{StaticResource DangerIconToggle}" Width="32" Height="32" FontSize="13" IsChecked="{Binding Muted}"
                                                                                  Content="&#xE74F;" ToolTip="Couper cette appli" Margin="8,0,6,0" />
                                                                    <ToggleButton Grid.Column="5" Style="{StaticResource SmallPillToggle}" IsChecked="{Binding ToMic}" Tag="{StaticResource MintBrush}"
                                                                                  Content="→ Micro" Margin="0,0,8,0" ToolTip="Envoie le son de cette appli dans ton micro : tes amis l'entendent"
                                                                                  Visibility="{Binding CanSendToMic, Converter={StaticResource BoolToVis}}" />
                                                                    <ComboBox Grid.Column="6" ItemsSource="{Binding Categories}" SelectedItem="{Binding MoveTo}" Height="32" FontSize="13" ToolTip="Changer de tranche" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Colonne de droite -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,10">
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Débruitage IA" c:Ui.Icon="&#xE945;" Margin="0,0,0,14" c:Ui.Subtitle="Clavier, ventilo, souffle"
                                                        DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding DenoiseOn}" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <c:ParamSlider Label="Intensité" Value="{Binding DenoiseAmount}" />
                                        <DockPanel Margin="0,12,0,8">
                                            <TextBlock Text="ENTRÉE" Style="{StaticResource MicroText}" Width="56" VerticalAlignment="Center" />
                                            <c:LevelMeter Height="5" Value="{Binding InputLevel}" Segments="28" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="SORTIE" Style="{StaticResource MicroText}" Width="56" VerticalAlignment="Center" />
                                            <c:LevelMeter Height="5" Value="{Binding OutputLevel}" Segments="28" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <!-- Voix active : carte irisée quand les effets sont allumés -->
                                <HeaderedContentControl Header="Voix active" c:Ui.Icon="&#xE720;" Margin="0,0,0,14" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <HeaderedContentControl.Style>
                                        <Style TargetType="HeaderedContentControl" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EffectsOn}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource IridescentBrush}" />
                                                    <Setter Property="BorderBrush" Value="#B3FFFFFF" />
                                                    <Setter Property="Foreground" Value="#141416" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </HeaderedContentControl.Style>
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding EffectsOn}" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentPresetName}" FontFamily="{StaticResource FontSemi}" FontSize="24" TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,12,0,0">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0" Background="#73FFFFFF" TextElement.Foreground="#B3141416"><TextBlock Text="CTRL ALT →" /></Border>
                                            <TextBlock Text="Voix suivante" FontFamily="{StaticResource FontMedium}" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Button Style="{StaticResource SmallSolidButton}" Content="Changer de voix" c:Ui.Icon="&#xE76C;" Click="GoVoice_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Ducking" c:Ui.Icon="&#xE767;" Margin="0,0,0,14"
                                                        c:Ui.Subtitle="Baisse la musique au bon moment">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,12">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SmallSwitch}" IsChecked="{Binding DuckOnMyVoice}" />
                                            <TextBlock Text="Quand je parle" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,12">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SmallSwitch}" IsChecked="{Binding DuckOnFriends}" />
                                            <TextBlock Text="Quand mes amis parlent" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <c:ParamSlider Label="Force de la baisse" Value="{Binding DuckAmount}" Tone="{StaticResource MintBrush}" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Écoute" c:Ui.Icon="&#xE7F6;" DataContext="{Binding DataContext, ElementName=PageVoice}">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource SmallSwitch}" Tag="{StaticResource VioletBrush}" IsChecked="{Binding MonitorOn}" ToolTip="T'entendre dans ton casque" />
                                    </HeaderedContentControl.Tag>
                                    <ComboBox ItemsSource="{Binding Speakers}" SelectedValue="{Binding SelectedMonitor}" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== EFFETS ========== -->
                    <DockPanel x:Name="PageEffects" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}" Margin="0,0,12,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding Bypass}" Content="A/B" c:Ui.Icon="&#xE8AB;"
                                              ToolTip="Entends ta vraie voix pour comparer (CTRL+ALT+B)" />
                                <Button Style="{StaticResource GhostButton}" Content="Réinitialiser" Click="ResetEffects_Click" />
                                <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="&#xE74E;" Content="Enregistrer" Click="SavePreset_Click" Margin="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Effets" Style="{StaticResource H2Text}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                    <Run Text="Règle chaque effet comme en studio · voix de base :" /> <Run Text="{Binding CurrentPresetName, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,12">
                            <TextBlock Text="CHAÎNE" Style="{StaticResource MicroText}" Margin="2,6,12,0" VerticalAlignment="Top" />
                            <ItemsControl ItemsSource="{Binding ActiveChain}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Tag}" Margin="0,0,4,6"><TextBlock Text="{Binding}" Style="{StaticResource BadgeText}" /></Border>
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,6" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel.Resources>
                                    <Style TargetType="c:AutoGrid">
                                        <Setter Property="MinItemWidth" Value="330" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                    </Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Margin" Value="-2,0,0,0" />
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="NETTOYAGE" Style="{StaticResource Section}" />
                                <c:AutoGrid>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Anti-bruit" c:Ui.Subtitle="Coupe le micro entre tes phrases (clavier, ventilo)">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding GateOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Seuil" Minimum="-80" Maximum="-20" Tick="1" Value="{Binding GateThresholdDb}" Format="{}{0} dB" Tone="{StaticResource MintBrush}" /></WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Réduction de bruit IA" c:Ui.Subtitle="Efface le bruit de fond, même pendant que tu parles">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding DenoiseOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Force" Value="{Binding DenoiseAmount}" Tone="{StaticResource MintBrush}" /></WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Coupe-bas" c:Ui.Subtitle="Enlève vibrations, chocs sur le bureau et « pop »">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding LowCutOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Fréquence" Minimum="20" Maximum="300" Tick="1" Value="{Binding LowCutHz}" Format="{}{0} Hz" Tone="{StaticResource MintBrush}" /></WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="De-esser" c:Ui.Subtitle="Adoucit les « sss » et « chhh » qui sifflent">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding DeEsserOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Force" Value="{Binding DeEsserAmount}" Tone="{StaticResource MintBrush}" /></WrapPanel>
                                    </HeaderedContentControl>
                                </c:AutoGrid>

                                <TextBlock Text="PITCH ET TIMBRE" Style="{StaticResource Section}" />
                                <c:AutoGrid>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Pitch" c:Ui.Subtitle="La note de ta voix, sans changer ton débit">
                                        <WrapPanel>
                                            <c:Knob Label="Demi-tons" Minimum="-12" Maximum="12" Origin="0" Tick="1" Value="{Binding PitchSemitones}" Format="{}{0:+0.0;-0.0;0.0} st" />
                                            <c:Knob Label="Coffre" Value="{Binding Depth}" Tone="{StaticResource ToneRose}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Timbre" c:Ui.Subtitle="Homme ↔ femme, enfant, géant · interrupteur = timbre naturel">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding KeepFormants}" ToolTip="Timbre naturel" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Formant" Minimum="-12" Maximum="12" Origin="0" Tick="0.5" Value="{Binding FormantSemitones}" Format="{}{0:+0.0;-0.0;0.0}" Tone="{StaticResource MintBrush}" /></WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Autotune" c:Ui.Subtitle="Corrige ta note en direct · vitesse au max = effet T-Pain">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding AutotuneOn}" /></HeaderedContentControl.Tag>
                                        <DockPanel>
                                            <c:Knob DockPanel.Dock="Left" Label="Vitesse" Value="{Binding AutotuneSpeed}" Margin="0,0,12,0" />
                                            <StackPanel VerticalAlignment="Top">
                                                <ComboBox ItemsSource="{Binding KeyNames}" SelectedIndex="{Binding AutotuneKey}" Height="34" FontSize="13" Margin="0,0,0,8" ToolTip="Tonalité" />
                                                <ComboBox ItemsSource="{Binding ScaleNames}" SelectedIndex="{Binding AutotuneScale}" Height="34" FontSize="13" ToolTip="Gamme" />
                                                <TextBlock Style="{StaticResource ReadoutText}" Margin="4,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="Note :" /> <Run Text="{Binding DetectedNote, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Harmoniseur" c:Ui.Subtitle="Ajoute une 2ᵉ voix : -12 = monstre, +7 = chœur">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding HarmonyOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Intervalle" Minimum="-12" Maximum="12" Origin="0" Tick="1" Value="{Binding HarmonySemitones}" Format="{}{0:+0;-0;0} st" />
                                            <c:Knob Label="Mix" Value="{Binding HarmonyMix}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                </c:AutoGrid>

                                <TextBlock Text="CARACTÈRE" Style="{StaticResource Section}" />
                                <c:AutoGrid>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Robot · alien" c:Ui.Subtitle="Fréquence basse = robot, haute = alien">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding RobotOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Fréquence" Minimum="20" Maximum="800" Tick="1" Value="{Binding RobotFrequency}" Format="{}{0} Hz" Tone="{StaticResource ToneSky}" />
                                            <c:Knob Label="Mix" Value="{Binding RobotMix}" Tone="{StaticResource ToneSky}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Chuchotement" c:Ui.Subtitle="Ta voix devient un souffle (fantôme, mystère)">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding WhisperOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Souffle" Value="{Binding WhisperAmount}" Tone="{StaticResource ToneSky}" /></WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Vibrato" c:Ui.Subtitle="Voix qui tremble (papy, fantôme, sous l'eau)">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding VibratoOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Vitesse" Minimum="0.5" Maximum="12" Value="{Binding VibratoRate}" Format="{}{0:0.0} Hz" Tone="{StaticResource ToneRose}" />
                                            <c:Knob Label="Profondeur" Value="{Binding VibratoDepth}" Tone="{StaticResource ToneRose}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Drive" c:Ui.Subtitle="Voix saturée, façon démon ou mégaphone">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding DistortionOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Drive" Value="{Binding DistortionDrive}" Tone="{StaticResource TonePeach}" /></WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="8-bit" c:Ui.Subtitle="Son de vieille console de jeu">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding BitcrushOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Bits" Minimum="2" Maximum="16" Tick="1" Value="{Binding BitcrushBits}" Format="{}{0} bits" Tone="{StaticResource TonePeach}" />
                                            <c:Knob Label="Échantillons" Minimum="1000" Maximum="24000" Value="{Binding BitcrushRateHz}" Format="{}{0:0} Hz" Tone="{StaticResource TonePeach}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Radio · talkie" c:Ui.Subtitle="Son de talkie-walkie ou de vieille radio">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding RadioOn}" /></HeaderedContentControl.Tag>
                                        <TextBlock Text="Pas de réglage : allume, c'est prêt." Style="{StaticResource TertiaryText}" />
                                    </HeaderedContentControl>
                                </c:AutoGrid>

                                <TextBlock Text="COULEUR ET DYNAMIQUE" Style="{StaticResource Section}" />
                                <c:AutoGrid>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Égaliseur 5 bandes" c:Ui.Subtitle="Chaleur, clarté, présence">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding EqOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <WrapPanel.Resources>
                                                <Style TargetType="c:Knob" BasedOn="{StaticResource {x:Type c:Knob}}">
                                                    <Setter Property="Width" Value="58" />
                                                    <Setter Property="Minimum" Value="-12" />
                                                    <Setter Property="Maximum" Value="12" />
                                                    <Setter Property="Origin" Value="0" />
                                                    <Setter Property="Format" Value="{}{0:+0.0;-0.0;0.0}" />
                                                </Style>
                                            </WrapPanel.Resources>
                                            <c:Knob Label="Graves" Value="{Binding EqLowDb}" />
                                            <c:Knob Label="Bas-méd." Value="{Binding EqLowMidDb}" />
                                            <c:Knob Label="Médiums" Value="{Binding EqMidDb}" />
                                            <c:Knob Label="Présence" Value="{Binding EqPresenceDb}" />
                                            <c:Knob Label="Aigus" Value="{Binding EqHighDb}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Filtre" c:Ui.Subtitle="Téléphone (300–3400 Hz), sous l'eau, derrière un mur…">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding FilterOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Coupe sous" Minimum="20" Maximum="2000" Tick="10" Value="{Binding FilterLowHz}" Format="{}{0} Hz" Tone="{StaticResource TonePeach}" />
                                            <c:Knob Label="Coupe dessus" Minimum="300" Maximum="16000" Tick="10" Value="{Binding FilterHighHz}" Format="{}{0} Hz" Tone="{StaticResource TonePeach}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Compresseur" c:Ui.Subtitle="Volume régulier, voix « radio »">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding CompressorOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel><c:Knob Label="Intensité" Value="{Binding CompressorAmount}" /></WrapPanel>
                                    </HeaderedContentControl>
                                </c:AutoGrid>

                                <TextBlock Text="ESPACE" Style="{StaticResource Section}" />
                                <c:AutoGrid>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Chorus" c:Ui.Subtitle="Plusieurs voix à la fois, son plus large">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding ChorusOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Vitesse" Minimum="0.05" Maximum="5" Value="{Binding ChorusRate}" Format="{}{0:0.00} Hz" Tone="{StaticResource ToneSky}" />
                                            <c:Knob Label="Profondeur" Value="{Binding ChorusDepth}" Tone="{StaticResource ToneSky}" />
                                            <c:Knob Label="Mix" Value="{Binding ChorusMix}" Tone="{StaticResource ToneSky}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Écho" c:Ui.Subtitle="Ta voix se répète… se répète…">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding EchoOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Délai" Minimum="40" Maximum="1000" Tick="1" Value="{Binding EchoTimeMs}" Format="{}{0} ms" Tone="{StaticResource MintBrush}" />
                                            <c:Knob Label="Répétitions" Maximum="0.9" Value="{Binding EchoFeedback}" Tone="{StaticResource MintBrush}" />
                                            <c:Knob Label="Mix" Value="{Binding EchoMix}" Tone="{StaticResource MintBrush}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource ModuleCard}" Header="Réverb" c:Ui.Subtitle="Comme dans une grande salle">
                                        <HeaderedContentControl.Tag><ToggleButton Style="{StaticResource AccentSwitch}" IsChecked="{Binding ReverbOn}" /></HeaderedContentControl.Tag>
                                        <WrapPanel>
                                            <c:Knob Label="Taille" Value="{Binding ReverbSize}" Tone="{StaticResource ToneRose}" />
                                            <c:Knob Label="Mix" Value="{Binding ReverbMix}" Tone="{StaticResource ToneRose}" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                </c:AutoGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- ========== SOUNDBOARD ========== -->
                    <DockPanel x:Name="PageSounds" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}" Margin="0,0,12,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassButton}" c:Ui.Icon="&#xE71A;" Content="Tout arrêter" Click="StopSounds_Click" ToolTip="CTRL+ALT+0" />
                                <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="&#xE710;" Content="Ajouter un son" Click="AddSounds_Click" Margin="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Soundboard" Style="{StaticResource H2Text}" />
                                <TextBlock Text="Tes sons, joués dans ton micro · raccourcis CTRL+ALT+1 à 9" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" Style="{StaticResource Tile}" Padding="18,12" Margin="0,0,12,16">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SmallSwitch}" IsChecked="{Binding SoundsToMonitor}" Margin="12,0,0,0" />
                                <TextBlock DockPanel.Dock="Right" Text="Les entendre aussi dans mon casque" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                <c:ParamSlider Label="Volume des sons" Minimum="-30" Maximum="6" Origin="0" Value="{Binding SoundVolumeDb}" Format="{}{0:+0;-0;0} dB" Width="340" HorizontalAlignment="Left" Margin="0" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Sounds}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><c:AutoGrid MinItemWidth="190" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SoundItem}">
                                            <Grid Height="124" Margin="0,0,12,12">
                                                <Button Click="PlaySound_Click" Tag="{Binding}" Cursor="Hand" Focusable="False" RenderTransformOrigin="0.5,0.5">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Style="{StaticResource Tile}" Padding="14" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                                                <DockPanel>
                                                                    <DockPanel DockPanel.Dock="Top">
                                                                        <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="0,0,28,0" VerticalAlignment="Top"
                                                                                Visibility="{Binding Hotkey, Converter={x:Static vm:Converters.NotEmptyToVisibility}}">
                                                                            <TextBlock Text="{Binding Hotkey}" FontSize="10" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource IconWell}" Background="{Binding ToneBrush}" HorizontalAlignment="Left">
                                                                            <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Center" />
                                                                        </Border>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontSemi}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassFillStrongBrush}" />
                                                                    <Setter TargetName="b" Property="Margin" Value="0,-2,0,2" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                        Content="&#xE711;" Click="RemoveSound_Click" Tag="{Binding}" ToolTip="Retirer" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- État vide : zone de dépôt en pointillés -->
                            <Grid x:Name="SoundsEmpty" Visibility="{Binding Sounds.Count, Converter={x:Static vm:Converters.ZeroToVisibility}}" Margin="0,0,12,10">
                                <Rectangle RadiusX="22" RadiusY="22" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="{DynamicResource GlassTileBrush}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Style="{StaticResource IconWell}" Width="56" Height="56" CornerRadius="18" Background="{StaticResource ToneViolet}" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Glisse tes sons ici" Style="{StaticResource H3Text}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                    <TextBlock Text="mp3, wav, ogg… Ils sont joués dans ton micro." Style="{StaticResource BodyText}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>

                    <!-- ========== RÉGLAGES ========== -->
                    <DockPanel x:Name="PageSettings" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}" Margin="0,0,12,18">
                            <StackPanel>
                                <TextBlock Text="Réglages" Style="{StaticResource H2Text}" />
                                <TextBlock Text="Micro virtuel, périphériques, raccourcis et apparence" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Seven Microphone" c:Ui.Icon="&#xE720;" c:Ui.Subtitle="Le micro virtuel que Discord et tes jeux utilisent">
                                        <HeaderedContentControl.Tag>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DangerBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CableFound}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                                                            <Setter Property="Text" Value="Absent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CableFound}" Value="True">
                                                                    <Setter Property="Text" Value="Actif" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </HeaderedContentControl.Tag>
                                        <StackPanel>
                                            <StackPanel Visibility="{Binding CableFound, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                                                           Text="Pour que Discord et tes jeux entendent ta voix modifiée, il faut un micro virtuel. se7en Voice installe « Seven Microphone » pour toi : il s'appuie sur le pilote gratuit VB-CABLE, téléchargé sur le site officiel de VB-Audio." />
                                                <TextBlock Text="1 · Clique sur « Installer Seven Microphone »" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                                <TextBlock Text="2 · Accepte la demande de Windows, puis clique « Install Driver » dans la fenêtre VB-Audio" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Text="3 · C'est prêt (parfois après un redémarrage du PC)" Style="{StaticResource LabelText}" Margin="0,0,0,16" />
                                                <TextBlock Text="{Binding CableInstallStatus}" Style="{StaticResource LabelText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                                                           Visibility="{Binding CableInstallStatus, Converter={x:Static vm:Converters.NotEmptyToVisibility}}" />
                                                <WrapPanel>
                                                    <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="&#xE896;" Content="Installer Seven Microphone" Click="InstallCable_Click" Margin="0,0,8,8"
                                                            IsEnabled="{Binding InstallingCable, Converter={x:Static vm:Converters.Not}}" />
                                                    <Button Style="{StaticResource GlassButton}" Content="Vérifier" Click="CheckCable_Click" Margin="0,0,8,8" />
                                                    <Button Style="{StaticResource GhostButton}" Content="Site de VB-CABLE" Click="DownloadCable_Click" Margin="0,0,8,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding CableFound, Converter={x:Static vm:Converters.BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10">
                                                    <Run Text="Dans Discord : Paramètres → Voix et vidéo → Périphérique d'entrée → choisis" />
                                                    <Run Text="{Binding CableName, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{StaticResource FontSemi}" /><Run Text="." />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                                                           Text="Pareil dans tes jeux. Coupe aussi la suppression de bruit de Discord (Krisp) : se7en Voice s'en charge." />
                                                <StackPanel Visibility="{Binding CableRenamed, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10" TextWrapping="Wrap"
                                                               Text="Le micro virtuel s'appelle encore « CABLE Output ». Renomme-le en « Seven Microphone » pour le retrouver facilement (Windows demandera l'autorisation)." />
                                                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" c:Ui.Icon="&#xE8AC;" Content="Renommer en « Seven Microphone »" Click="RenameCable_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Périphériques" c:Ui.Icon="&#xE7F6;" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="MICRO" Style="{StaticResource MicroText}" Margin="4,0,0,8" />
                                            <ComboBox ItemsSource="{Binding Microphones}" SelectedValue="{Binding SelectedMicrophone}" Margin="0,0,0,16" />
                                            <TextBlock Text="CASQUE (POUR T'ÉCOUTER)" Style="{StaticResource MicroText}" Margin="4,0,0,8" />
                                            <ComboBox ItemsSource="{Binding Speakers}" SelectedValue="{Binding SelectedMonitor}" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Push-to-talk" c:Ui.Icon="&#xE765;" Margin="0,14,0,0"
                                                            c:Ui.Subtitle="Marche partout, même en jeu · touche ou bouton de souris">
                                        <HeaderedContentControl.Tag>
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PushToTalkOn}" />
                                        </HeaderedContentControl.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource KeyChip}" MinWidth="110" MinHeight="32">
                                                <TextBlock Text="{Binding PushToTalkKeyName}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                            </Border>
                                            <Button Style="{StaticResource SmallGlassButton}" Content="Changer la touche" Click="CaptureKey_Click" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Apparence" c:Ui.Icon="&#xE790;">
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Clair" c:Ui.Icon="&#xE706;" GroupName="Theme2" IsChecked="{Binding IsLight}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Sombre" c:Ui.Icon="&#xE708;" GroupName="Theme2" IsChecked="{Binding IsDark}" />
                                            </StackPanel>
                                        </Border>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Application" c:Ui.Icon="&#xE713;" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel Style="{StaticResource SettingRow}">
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                                                <StackPanel>
                                                    <TextBlock Text="Lancer au démarrage de Windows" Style="{StaticResource LabelText}" />
                                                    <TextBlock Text="Ta voix est prête dès que le PC s'allume" Style="{StaticResource TertiaryText}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource SettingRow}" Margin="0">
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" />
                                                <StackPanel>
                                                    <TextBlock Text="Rester actif à la fermeture" Style="{StaticResource LabelText}" />
                                                    <TextBlock Text="La croix cache l'appli près de l'horloge au lieu de la quitter" Style="{StaticResource TertiaryText}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Enregistrements" c:Ui.Icon="&#xE7C8;" Margin="0,14,0,0"
                                                            c:Ui.Subtitle="Le bouton Enregistrer garde ce qu'entendent tes amis en .wav">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecordingsFolder}" Style="{StaticResource ReadoutText}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                            <WrapPanel>
                                                <Button Style="{StaticResource SmallGlassButton}" c:Ui.Icon="&#xE838;" Content="Ouvrir le dossier" Click="OpenRecordings_Click" />
                                                <Button Style="{StaticResource SmallGhostButton}" Content="Changer" Click="ChooseRecordings_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Style="{StaticResource Card}" Header="Raccourcis" c:Ui.Icon="&#xE765;" Margin="0,14,0,0" c:Ui.Subtitle="Marchent même en jeu">
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <Style TargetType="DockPanel"><Setter Property="Margin" Value="0,0,0,10" /></Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource KeyChip}"><Setter Property="Width" Value="140" /></Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                                            </StackPanel.Resources>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT M" Style="{x:Null}" /></Border><TextBlock Text="Couper / remettre le micro" /></DockPanel>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT → / ←" Style="{x:Null}" /></Border><TextBlock Text="Voix suivante / précédente" /></DockPanel>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT F1…F9" Style="{x:Null}" /></Border><TextBlock Text="Voix favorite n° 1 à 9" /></DockPanel>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT N" Style="{x:Null}" /></Border><TextBlock Text="Revenir à la voix normale" /></DockPanel>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT B" Style="{x:Null}" /></Border><TextBlock Text="A/B : effets coupés / rallumés" /></DockPanel>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT R" Style="{x:Null}" /></Border><TextBlock Text="Lancer / arrêter l'enregistrement" /></DockPanel>
                                            <DockPanel><Border><TextBlock Text="CTRL ALT 1…9" Style="{x:Null}" /></Border><TextBlock Text="Jouer un son de la soundboard" /></DockPanel>
                                            <DockPanel Margin="0"><Border><TextBlock Text="CTRL ALT 0" Style="{x:Null}" /></Border><TextBlock Text="Arrêter tous les sons" /></DockPanel>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ===== Barre du bas : voix favorites ===== -->
            <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource GlassPill}" HorizontalAlignment="Center" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding QuickVoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PresetItem}">
                                <RadioButton Style="{StaticResource Tab}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="QuickVoice_Click" Tag="{Binding}" GroupName="Quick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" Background="{DynamicResource SurfaceSolidBrush}" Foreground="{DynamicResource TextOnSolidBrush}"
                            BorderBrush="Transparent" Content="&#xE710;" Margin="4,0,0,0" Click="GoVoice_Click" ToolTip="Toutes les voix (l'étoile ajoute une voix ici)" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" Padding="10,10,18,10" CornerRadius="22"
                Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                MinWidth="320" MaxWidth="480" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource PopShadow}">
            <DockPanel>
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource GelVioletBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitle" FontFamily="{StaticResource FontSemi}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Premier lancement : installer Seven Microphone ===== -->
        <Grid x:Name="CableDialog" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
            <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="32" Background="{DynamicResource MenuBrush}"
                    BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1" Padding="28" Effect="{DynamicResource PopShadow}">
                <StackPanel>
                    <Border Style="{StaticResource IconWell}" Width="52" Height="52" CornerRadius="17" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE720;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Installer Seven Microphone" Style="{StaticResource H2Text}" Margin="0,16,0,6" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="C'est le micro que tu choisiras dans Discord et tes jeux : ils entendront ta voix modifiée. Gratuit, environ 1 minute. Windows te demandera l'autorisation, puis clique « Install Driver » dans la fenêtre VB-Audio." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Plus tard" Click="CableDialogLater_Click" />
                        <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="&#xE896;" Content="Installer" Click="CableDialogInstall_Click" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Nouveau preset ===== -->
        <Grid x:Name="SaveDialog" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="32" Background="{DynamicResource MenuBrush}"
                    BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1" Padding="28" Effect="{DynamicResource PopShadow}">
                <StackPanel>
                    <TextBlock Text="Nouveau preset" Style="{StaticResource H2Text}" />
                    <TextBlock Text="Enregistre les réglages actuels sous un nouveau nom." Style="{StaticResource BodyText}" Margin="0,8,0,18" />
                    <TextBox x:Name="PresetNameBox" KeyDown="PresetNameBox_KeyDown" MaxLength="28" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="CancelSave_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="ConfirmSave_Click" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
